* TEST THE NEXT XLRAS FOR VALIDITY...NOT FOXES AND RIGHTMOST BYTE=0
*    HXLRA, BMAP, EMAP, MAPNW, BDATA, EDATA
         LA    R3,6               R3=NO. OF FIELDS
         LA    R7,PFXHXLRA        R7=ADDRESS OF START VALUE
VERXLRA1 DS    0H
         CLI   7(R7),0            RIGHTMOST BYTE ZERO ?
         JNE   VERXLRAE           ERROR IF NOT
         CGHSI 0(R7),-1           FIELD NOT FOXES ?
         JNE   VERXLRAK           EXIT IF NOT
VERXLRAE DS    0H
* FIELD IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LR    R4,R7              R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERXLRAK DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
         AHI   R7,8               BUMP FIELD POINTER
         JCT   R3,VERXLRA1        LOOP
*
* TEST THE FOLLOWING FOR FOXES IF NOT SPANNED
*    BSEGM,ESEGM
* IF SPANNED AND FOXES, ISSUE WARNING THAT NO RECORD WAS SEGMENTED
         TM    PFXRFLGS,PFX_RSPN  SPANNED ?
         JO    VERSPAN            EXIT IF IT IS
* NOT SPANNED
* PFXBSEGM
         CGHSI PFXBSEGM,-1        BSEGM=FOXES ?
         JE    VERBSEGK           EXIT IF IT IS
* PFXBSEGM IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LA    R4,PFXBSEGM        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERBSEGK DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
* PFXESEGM
         CGHSI PFXESEGM,-1        ESEGM=FOXES ?
         JE    VERESEGK           EXIT IF IT IS
* PFXESEGM IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LA    R4,PFXESEGM        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERESEGK DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
         J     VERROOT            EXIT
*
VERSPAN  DS    0H
* SPANNED
* PFXBSEGM/PFXESEGM SHOULD NOT BE FOXES
         CGHSI PFXBSEGM,-1        BSEGM=FOXES ?
         JE    VERSEGER           ERROR IF IT IS
         CGHSI PFXESEGM,-1        ESEGM=FOXES ?
         JNE   VERSEGM            EXIT IF NOT
VERSEGER DS    0H
* ISSUE WARNING:SPANNED AND NO SEGMENTS CREATED
         WTO   MF=(E,WTOVERSE)    DISPLAY WARNING
         ASI   VEROFFST,16        BUMP OFFSET
         J     VERROOT            EXIT
*
VERSEGM  DS    0H
* PFXBSEGM VALID XLRA
         CLI   PFXBSEGM+7,0       RIGHTMOST BYTE ZERO ?
         JE    VERBSEG2           EXIT IF IT IS
* PFXBSEGM IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LA    R4,PFXBSEGM        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERBSEG2 DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
* PFXESEGM VALID XLRA
         CLI   PFXESEGM+7,0       RIGHTMOST BYTE ZERO ?
         JE    VERESEG2           EXIT IF IT IS
* PFXESEGM IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LA    R4,PFXESEGM        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERESEG2 DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
VERROOT  DS    0H
* TEST THE NEXT XLRAS FOR VALIDITY...ALL FOXES
*    ROOT, BLVLx
         LA    R3,33              R3=NO. OF FIELDS
         LA    R7,PFXROOT         R7=ADDRESS OF START VALUE
VERROOTL DS    0H
         CGHSI 0(R7),-1           FIELD=FOXES ?
         JE    VERROOTK           EXIT IF IT IS
* FIELD IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LR    R4,R7              R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERROOTK DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
         AHI   R7,8               BUMP FIELD POINTER
         JCT   R3,VERROOTL        LOOP
*
         ASI   VEROFFST,4+5*8     BUMP OFFSET (MISS MAPOF+STCKS)
* PFXFRSPC
         CLI   PFXFRSPC,X'64'     LESS THAN 100 ?
         JL    VERFRSOK           EXIT IF IT IS
