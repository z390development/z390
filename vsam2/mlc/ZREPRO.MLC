         JNO   VERKYLOK           EXIT IF NOT
         CLC   PFXKYLEN,VXXXKLEN  MATCHES CATALOG ?
         JE    VERKYLOK           EXIT IF IT DOES
* PFXKYLEN IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,PFXKYLEN        R4=ADDRESS OF INCORRECT VALUE
         LA    R5,VXXXKLEN        R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERKYLOK DS    0H
         ASI   VEROFFST,4         BUMP OFFSET
* PFXKYOFF MATCHES CATALOG (KSDS ONLY)
         CLC   PFXKYOFF,VXXXKOFF  MATCHES CATALOG ?
         JE    VERKYOOK           EXIT IF IT DOES
* PFXKYOFF IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,PFXKYOFF        R4=ADDRESS OF INCORRECT VALUE
         LA    R5,VXXXKOFF        R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERKYOOK DS    0H
         ASI   VEROFFST,4         BUMP OFFSET
* PFXDVOL@
         CHHSI PFXDVOL@,-1        DVOL@=FOXES ?
         JE    VERDVOLK           EXIT IF IT IS
* PFXDVOL@ IN ERROR
         LA    R9,2               R9=LENGTH TO DISPLAY
         LA    R4,PFXDVOL@        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERDVOLK DS    0H
         ASI   VEROFFST,2         BUMP OFFSET
* MATCH DPAT/DNAM WITH VSAMDTAI
* DISPLAY 1ST 32 BYTES IF MISMATCH
         LH    R4,PFXDPAT@        R4=DATA PATH OFFSET
         AR    R4,R6              R4=DATA PATH POINTER
         LH    R5,0(R4)           R5=LENGTH (INC. LL)
         AHI   R4,2               BUMP PAST LENGTH
         AHI   R5,-2-1            LENGTH-2, -1 FOR EXECUTE
         LA    R2,VERFILE         R2=PATH\FILE AREA
         EXRL  R5,VERMOVPF        MOVE PATH
         LA    R2,1(R2,R5)        R2=POINT AFTER PATH
         MVI   0(R2),C'\'         INSERT BACKSLASH
         AHI   R2,1               BUMP POINTER
         LH    R4,PFXDNAM@        R4=DATA FILENAME OFFSET
         AR    R4,R6              R4=DATA FILENAME POINTER
         LH    R5,0(R4)           R5=LENGTH (INC. LL)
         AHI   R4,2               BUMP PAST LENGTH
         AHI   R5,-2-1            LENGTH-2, -1 FOR EXECUTE
         EXRL  R5,VERMOVPF        MOVE FILENAME
         SGR   R0,R0              SET STOPPER TO X'00'
         LA    R4,VSAMDTAI        R4=PATH\FILE OPENED
         LA    R5,VERFILE         R5=PATH\FILE IN PFX
         CLST  R4,R5              MATCH ?
         JE    VERDPATK           EXIT IF IT DOES
* PFXDPAT@/DNAM@ IN ERROR
         MVI   WTOCOREC,C' '      CLEAR
         MVC   WTOCOREC+1(31),WTOCOREC  WTOCOREC
         LA    R5,VSAMDTAI        R5=ADDRESS OF CORRECT VALUE
* WTO STOPS AT X'00', MUST MOVE BYTE-BY-BYTE
         LA    R1,32              R1=LOOP LIMIT
         LA    R15,WTOCOREC       R15=WTOCOREC
VERLOOPC DS    0H
         CLI   0(R5),0            NULL STOPPER ?
         JE    VERCORDN           EXIT IF IT IS
         MVC   0(1,R15),0(R5)     MOVE BYTE
         AHI   R15,1              BUMP POINTER
         AHI   R5,1               BUMP POINTER
         JCT   R1,VERLOOPC        LOOP
*
VERCORDN DS    0H
         MVI   WTOINCOR,C' '      CLEAR
         MVC   WTOINCOR+1(31),WTOINCOR  WTOINCOR
         LA    R4,VERFILE         R4=ADDRESS OF INCORRECT VALUE
         LA    R1,32              R1=LOOP LIMIT
         LA    R15,WTOINCOR       R15=WTOCOREC
VERLOOPI DS    0H
         CLI   0(R4),0            NULL STOPPER ?
         JE    VERINCDN           EXIT IF IT IS
         MVC   0(1,R15),0(R4)     MOVE BYTE
         AHI   R15,1              BUMP POINTER
         AHI   R4,1               BUMP POINTER
         JCT   R1,VERLOOPI        LOOP
*
VERINCDN DS    0H
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         JAS   R14,VERSHOWO       BUILD OFFSET AND WTO
VERDPATK DS    0H
         ASI   VEROFFST,2+2       BUMP OFFSET (DNAM@+DPAT@)
* PFXXVOL@
         CHHSI PFXXVOL@,-1        XVOL@=FOXES ?
         JE    VERXVOLK           EXIT IF IT IS
* PFXXVOL@ IN ERROR
         LA    R9,2               R9=LENGTH TO DISPLAY
         LA    R4,PFXXVOL@        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERXVOLK DS    0H
         ASI   VEROFFST,2+2+2     BUMP OFFSET (XVOL@+XNAM@+XPAT@)
* NOT DOING XNAM@, XPAT@ HERE
* PFXIXLVL
         CLI   PFXIXLVL,0         PFXIXLVL=0 ?
         JE    VERIXLVK           EXIT IF IT IS
* PFXIXLVL IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,PFXIXLVL        R4=ADDRESS OF INCORRECT VALUE
