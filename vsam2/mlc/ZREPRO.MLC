VERALTHK DS    0H
         ASI   VEROFFST,1         BUMP OFFSET
* PFXBLKSZ
         CHSI  PFXBLKSZ,0         PFXBLKSZ NOT ZERO ?
         JNE   VERBLKSK           EXIT IF NOT
* PFXBLKSZ IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,PFXBLKSZ        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERBLKSK DS    0H
