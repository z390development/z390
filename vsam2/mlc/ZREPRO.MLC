*
BADRECFM DS    0H
* QSAM IS FIXED, VSAM IS VARIABLE
* QSAM IS VARIABLE, VSAM IS FIXED
         WTO   'zREPRO INPUT AND OUTPUT HAVE DIFFERENT RECFM'
         J     BADRETN            EXIT
*
BADQSAMO DS    0H
         WTO   'zREPRO INVALID QSAM OVERRIDE'
         J     BADRETN            EXIT
*
BADSETFX DS    0H
         WTO   'zREPRO INVALID FIXED INPUT QSAM RECFM'
         J     BADRETN            EXIT
*
BADSETVR DS    0H
         WTO   'zREPRO INVALID VARIABLE QSAM RECFM'
         J     BADRETN            EXIT
*
BADOPENQ DS    0H
         WTO   'zREPRO QSAM INPUT FILE OPEN FAILED'
         J     BADRETN            EXIT
*
BADOPEND DS    0H
         WTO   'zREPRO OUTPUT DATA FILE OPEN FAILED'
         J     BADRETN            EXIT
*
BADOPENI DS    0H
         WTO   'zREPRO INPUT DATA FILE OPEN FAILED'
         J     BADRETN            EXIT
*
BADOPENX DS    0H
         WTO   'zREPRO INDEX FILE OPEN FAILED'
         J     BADRETN            EXIT
*
BADFIT   DS    0H
         WTO   'zREPRO LRECL EXCEEDS FREESPACE'
         J     BADRETN            EXIT
*
BADFITX  DS    0H
         WTO   'zREPRO INDEX RECORD EXCEEDS FREESPACE'
         J     BADRETN            EXIT
*
BADSLOT  DS    0H
         WTO   'zREPRO RRN EXCEEDS 4GB'
         J     BADRETN            EXIT
*
BADRRNSQ DS    0H
         WTO   'zREPRO RRN NOT IN ASCENDING SEQUENCE'
         J     BADRETN            EXIT
*
BADVSAM  DS    0H
* WTO INVALID VSAM DSN FORMAT CODE=NN
         WTO   MF=(E,WTOBADFM)    SHOW IT
BADRETN  DS    0H
         SUBEXIT RC=15
*
BADUNLD  DS    0H
         WTO   'zREPRO UNLOAD FAILED: VARIABLE RECORD TOO LARGE'
         J     BADRETN            EXIT
*
UNLOAD   DS    0H
**********
* UNLOAD *
**********
* AT PRESENT, AN AIX (AS A VARIABLE SPANNED FILE) WILL NOT BE
* CONSIDERED VALID FOR UNLOAD, BECAUSE THE MAXIMUM RECORD SIZE
* IS NOT IN THE CATALOG
* IT COULD BE CONSIDERED IF I WROTE MAXVAR INTO THE PREFIX BLOCK
* AND THAT WAS MAINTAINED FOR ANY AIX UPDATES
*
         L     R5,GETENVO         R5=OUTPUT QSAM PATH ADDRESS
* PROCESS QSAM ENVIRONMENT VARIABLE
*
* FORM THE DSN IN THE ENVIRONMENT VARIABLE
* SET OUTQSAM=E:\Z390\CICS\VSAM\MYFILE8F.TXT[RECFM=FT]
         MVI   FINDDOT,0          DON'T FIND DOT
         TRT   0(128,R5),FINDSTOP FIND X'00' [
         MVI   FINDDOT,C'.'       RESET DOT
         CLI   0(R1),C'['         GOT AN OVERRIDE ?
         JNE   PROCQENU           EXIT IF NOT
         MVI   0(R1),0            TERMINATE QSAM DSNAME FOR OPEN
* E:\Z390\ZVSAM\MYFILE8F.TXT X'00'[RECFM=FT]
         LARL  R4,WTOINFS         R4=BASE FOR INFO LINE
         USING WTOINFDS,R4
         CLC   1(6,R1),WTOQVSAM+9 ANY RECFM= OVERRIDE ?
         JNE   BADQSAMO           ERROR IF NOT
* RECFM OVERRIDE VALIDATION
         CHHSI 7(R1),C'VT'        VARIABLE TRANSLATE ?
         JNE   QSAMNVTU           EXIT IF NOT
         MVHHI WTORECFM,C'VT'     SET IT FOR WTO
         J     PROCQENU           EXIT
*
QSAMNVTU DS    0H
         CHHSI 7(R1),C'FT'        FIXED TRANSLATE ?
         JNE   BADQSAMO           ERROR IF NOT
         MVHHI WTORECFM,C'FT'     SET IT FOR WTO
PROCQENU DS    0H
         ST    R5,OUTFILEQ+DCBDSNAM-IHADCB SET DSNAME
         MVI   ITYPE,C'I'         SET INPUT PROCESSING
         L     R5,GETENVI         R5=INPUT VSAM PATH ADDRESS
         JAS   R14,PROCVSAM       PROCESS VSAM, LOAD CAT, BUILD DSN
         TM    VXXXFLG1,VCLRVREC  VARIABLE ?
         JNO   VQSETFIX           EXIT IF NOT
* VARIABLE
         CLI   WTORECFM,C'F'      FIXED QSAM ?
         JE    BADRECFM           ERROR IF IT IS
         MVI   OUTFILEQ+DCBRECFM-IHADCB,DCBRECFM_V SET IN DCB (DEFAULT)
         CHHSI WTORECFM,C'XX'     IS RECFM SET FROM OVERRIDE ?
         JE    UNLDVQ             EXIT IF NOT
* SET RECFM FROM OVERRIDE
         CHHSI WTORECFM,C'VT'     VARIABLE TRANSLATE ?
         JNE   BADSETVR           ERROR IF NOT
         MVI   OUTFILEQ+DCBRECFM-IHADCB,DCBRECFM_VT SET VT IN DCB
         J     UNLDVQ             EXIT
*
VQSETFIX DS    0H
* FIXED VSAM
         CLI   WTORECFM,C'V'      VARIABLE QSAM ?
         JE    BADRECFM           ERROR IF IT IS
         MVI   OUTFILEQ+DCBRECFM-IHADCB,DCBRECFM_F SET DCB (DEFAULT)
         CHHSI WTORECFM,C'XX'     IS RECFM SET FROM OVERRIDE ?
         JE    UNLDVQ             EXIT IF NOT
* SET RECFM FROM OVERRIDE
         CHHSI WTORECFM,C'FT'     FIXED TRANSLATE ?
         JNE   BADSETFX           ERROR IF NOT
         MVI   OUTFILEQ+DCBRECFM-IHADCB,DCBRECFM_FT SET FT IN DCB
UNLDVQ   DS    0H
*****************************************
* QSAM AND VSAM ARE BOTH FIXED/VARIABLE *
*****************************************
* OPEN INPUT VSAM DTA
         OPEN  (DTAIN,(INPUT))    OPEN VSAM DATA INPUT DCB
         LTR   R15,R15            OK ?
         JNZ   BADOPEND           ERROR IF NOT
* SHOW INPUT DTA FILE OPENED: PATH
         MVC   OPENMSG,WTOINPVD   MOVE 'INPUT DTA OPENED' MSG
         L     R1,GETENVI         R1=VSAM INPUT PATH ADDRESS
         JAS   R14,OPENWTO        WTO OPEN FILE
* OPEN OUTPUT QSAM
         OPEN  (OUTFILEQ,(OUTPUT)) OPEN QSAM OUTPUT
         LTR   R15,R15            OK ?
         JNZ   BADOPENQ           ERROR IF NOT
* SHOW OUTPUT FILE OPENED: PATH
         MVC   OPENMSG,WTOOUT     MOVE 'OUTPUT OPENED' MSG
         L     R1,GETENVO         R1=VSAM OUTPUT PATH ADDRESS
         JAS   R14,OPENWTO        WTO OPEN FILE
* SET UP THE INFO LINE AND DISPLAY IT
         CLI   ITYPE,C'A'         IS OUTPUT CLUSTER AN AIX ?
         JNE   SETNAIXU           EXIT IF NOT
* AIX
* NOT YET VALID FOR UNLOAD, BUT LEAVING THE CODE HERE
         MVI   WTOQVSAM+3,C'V'    SET VSAM INPUT
         MVC   WTOXXDS(4),CNSTAIXU SET AIX UNIQUE
         TM    VXXXFLG1,VAIXUKEY  UNIQUE ?
         JO    SETSPANU           EXIT IF IT IS
* AIX NON-UNIQUE
         MVHHI WTORECFM,C'V '     SET AIX AS VARIABLE
         MVI   WTOXXDS+3,C'N'     SET AIX NON-UNIQUE
         MVC   WTOVRFX(8),CNSTVARB SET VARIABLE
         MVC   WTONSPAN(10),CNSTSPAN SET SPANNED
* DISPLAY UNLOAD NOT VALID FOR AIX
         WTO   MF=(E,WTOBADUN)    SHOW IT
         J     BADRETN            EXIT
*
SETNAIXU DS    0H
         TM    VXXXFLG1,VCLRKSDS  KSDS ?
         JO    SETXXDSU           EXIT IF IT IS
         MVHHI WTOXXDS,C'RR'      SET RRDS
         TM    VXXXFLG1,VCLRRRDS  RRDS ?
         JO    SETXXDSU           EXIT IF IT IS
         MVHHI WTOXXDS,C'ES'      SET ESDS
SETXXDSU DS    0H
         TM    VXXXFLG1,VCLRVREC  VARIABLE ?
         JNO   SETNVARU           EXIT IF NOT
         MVC   WTOVRFX(8),CNSTVARB SET VARIABLE
SETNVARU DS    0H
         TM    VXXXFLG1,VCLRSPAN  SPANNED ?
         JNO   SETSPANU           EXIT IF IT IS
         MVC   WTONSPAN(10),CNSTSPAN SET SPANNED
         DROP  R4
SETSPANU DS    0H
* GETMAIN 4K FOR DATA PREFIX BLOCK
         LHI   R1,4096            R1=4K
         GETMAIN RU,LV=(R1)
         ST    R1,VSAMPRFX        SAVE ADDRESS
         LR    R6,R1              R6=VSAM DATA PREFIX ADDRESS
* GET DATA PREFIX BLOCK
         LHI   R2,4096            R2=PREFIX BLOCKSIZE
         ST    R2,DTAIN+DCBBLKSIF-IHADCB SAVE BLKSIZE
         ST    R2,DTAIN+DCBLRECLF-IHADCB SAVE LRECL
         GET   DTAIN,(R6)         GET DATA PREFIX BLOCK
         USING ZVSAMHDR,R6
         USING ZVSAMPFX,ZVSAMHDR+BHDRLENG
         LG    R2,PFXBDATA        R2=FIRST DATA XLRA
         MVC   TRUDBKSZ,PFXBLKSZ  SET DATA BLKSIZE
         MVC   PXXFFLGS,PFXFFLGS  COPY DATA PFXFFLGS
         MVC   PXXRFLGS,PFXRFLGS  COPY DATA PFXRFLGS
         DROP  R6
* GETMAIN DATA BLOCK
         L     R6,TRUDBKSZ        R6=(ADJUSTED) DATA BLKSIZE
         ST    R6,DTAIN+DCBBLKSIF-IHADCB SAVE BLKSIZE
         ST    R6,DTAIN+DCBLRECLF-IHADCB SAVE LRECL
         GETMAIN RU,LV=(R6)
         ST    R1,VSAMDATA        SAVE VSAM DATA BLOCK ADDRESS
         LR    R6,R1              R6=VSAM DATA BLOCK ADDRESS
* GETMAIN OUTPUT RECORD
* +4  FOR VARIABLE
* +10 FOR RRDS
         L     R8,VXXXLMAX        R8=MAXIMUM RECORD LENGTH
         TM    VXXXFLG1,VCLRVREC  VARIABLE ?
         JNO   UNLDNVAR           EXIT IF NOT
* VARIABLE
         AHI   R8,4               +4 FOR RLF
UNLDNVAR DS    0H
         TM    VXXXFLG1,VCLRRRDS  RRDS ?
         JNO   UNLDNRRD           EXIT IF NOT
* RRDS
         AHI   R8,10              +10 FOR RRN
UNLDNRRD DS    0H
         ST    R8,OUTFILEQ+DCBBLKSIF-IHADCB SAVE BLKSIZE
         ST    R8,OUTFILEQ+DCBLRECLF-IHADCB SAVE LRECL
         CVD   R8,WORK3           CONVERT LRECL
         LARL  R15,WTOINFS        R15=BASE FOR INFO LINE
         USING WTOINFDS,R15
         ED    WTODLREC,WORK3+4   EDIT LRECL
         MVI   WTODLREC,C'='      SET =
         DROP  R15
* DISPLAY INFO LINE
         WTO   MF=(E,WTOINFOU)    DISPLAY INFO LINE
         GETMAIN RU,LV=(R8)
         ST    R1,VSAMINBF        SAVE OUTPUT BLOCK ADDRESS
* FOR RRDS, ALLOW SPACE FOR THE RRN
         TM    VXXXFLG1,VCLRRRDS  RRDS ?
         JNO   UNLDNRRN           EXIT IF NOT
* RRDS
         ASI   VSAMINBF,10        ADDRESS+10
UNLDNRRN DS    0H
* FOR SPANNED, GETMAIN AN AREA FOR SEGMENTS (UNSPAN)
         TM    VXXXFLG1,VCLRSPAN  SPANNED ?
         JNO   UNLDNSPN           EXIT IF NOT
* SPANNED
         L     R8,TRUDBKSZ        R8=(ADJUSTED) DATA BLKSIZE
         GETMAIN RU,LV=(R8)
         ST    R1,VSAMPREV        SAVE PREVIOUS BLOCK ADDRESS
UNLDNSPN DS    0H
         SR    R8,R8              CLEAR R8
UNLDLOOP DS    0H
         SRLG  R2,R2,8            SHIFT OUT RECORD NUMBER
         MSGF  R2,TRUDBKSZ        * (ADJUSTED) DATA BLKSIZE
         ALGFI R2,4096            + PREFIX SIZE
         STG   R2,WORK1           SAVE IT
         POINT DTAIN,RBA=WORK1    POINT TO DATA BLOCK
         GET   DTAIN,(R6)         GET DATA BLOCK
         USING ZVSAMHDR,R6
         AHIK  R9,R6,BHDRLENG     R9=DATA RPTR POINTER
         USING ZVSAMRPT,R9
UNLDBLCK DS    0H
* LOOP WITHIN DATA BLOCK
         CLI   RPTRFLGS,RPTR_END  END OF DATA RPTR'S ?
         JE    UNLDENDB           EXIT IF IT IS
         TM    VXXXFLG1,VCLRRRDS  RRDS ?
         JNO   UNLDNRR2           EXIT IF NOT
* RRDS
* BUILD THE RRN AND RECORD IF ACTIVE
         TM    RPTRFLGS,RPTR_MTY  ACTIVE ?
         JNO   UNLDACTV           EXIT IF IT IS
* INACTIVE
         AGSI  UNLDRRN,1          BUMP RRN
         J     UNLDBUMP           EXIT
*
UNLDACTV DS    0H
* ACTIVE RRDS RECORD
         L     R5,VSAMINBF        R5=OUTPUT BUFFER
         LG    R3,UNLDRRN         R3=CURRENT RRN
         CVDG  R3,WORK1           CONVERT TO DECIMAL
         UNPK  WORK1+16(11),WORK1+10(6) UNPACK
         OI    WORK1+26,X'F0'     SET SIGN
         L     R8,RPTRREC@        R8=OFFSET TO RECORD
         AR    R8,R6              R8=RECORD ADDRESS
         TM    VXXXFLG1,VCLRVREC  VARIABLE ?
         JNO   UNLDFIXR           EXIT IF NOT
* ACTIVE AND VARIABLE RRDS
* BUILD MODIFIED RDW,RRN,RECORD
         TM    RPTRFLGS,RPTR_SEG  FIRST SEGMENT ?
         JNO   UNLDNRRS           EXIT IF NOT
* VARIABLE SPANNED RRDS
* UNSPAN INTO VSAMINBF+10
* CL10,RLF,REC TO RDW+10,RRN,REC
         IC    R2,ITYPE           SAVE ITYPE
         MVI   ITYPE,C'A'         FOOL UNSPAN INTO USING GET
         JAS   R14,UNSPAN         RECONSTRUCT A SPANNED RECORD
         STC   R2,ITYPE           RESTORE ITYPE
         L     R5,VSAMINBF        R5=UNSPANNED RECORD
         AHI   R5,-10             BACK TO BUFFER START
* TEST LIMITS
         L     R3,10(R5)          R3=RLF
         AHI   R3,10              LENGTH+10 FOR RRN
         CFI   R3,32767           MAX RDW BUSTED ?
         JH    BADUNLD            ERROR IF IT IS
         C     R3,VXXXLMAX        LARGER THAN MAX RECORD LENGTH ?
         JH    BADUNLD            ERROR IF IT IS
         ST    R3,0(R5)           SAVE RLF
         MVC   4(10,R5),WORK1+17  MOVE RRN
         J     UNLDPREP           EXIT
*
UNLDNRRS DS    0H
* VARIABLE UNSPANNED RRDS
         L     R3,0(R8)           R3=RLF
         AHI   R3,10              LENGTH+10 FOR RRN
         CFI   R3,32767           MAX RDW BUSTED ?
         JH    BADUNLD            ERROR IF IT IS
         AHI   R3,-(10+4)         R3=ACTUAL RECORD SIZE (-RRN-RLF)
         C     R3,VXXXLMAX        LARGER THAN MAX RECORD LENGTH ?
         JH    BADUNLD            ERROR IF IT IS
         AHI   R3,10+4            R3=RECORD SIZE+RRN+RLF
         ST    R3,0(R5)           SAVE RLF
         MVC   4(10,R5),WORK1+17  MOVE RRN
         L     R11,0(R8)          R11=RECORD LENGTH (INCLUDES RLF)
         AHI   R11,-4             -RLF LENGTH
         LA    R10,14(R5)         R10=DESTINATION
         LA    R0,4(R8)           R0=SOURCE
         LR    R1,R11             R1=LENGTH
         MVCL  R10,R0             MOVE VARIABLE RRDS RECORD
         J     UNLDPREP           EXIT
*
UNLDFIXR DS    0H
* ACTIVE AND FIXED RRDS
* BUILD RRN,RECORD
         TM    RPTRFLGS,RPTR_SEG  FIRST SEGMENT ?
         JNO   UNLDNRRF           EXIT IF NOT
* FIXED SPANNED RRDS
* UNSPAN INTO VSAMINBF+10
* CL10,REC TO RRN,REC
         IC    R2,ITYPE           SAVE ITYPE
         MVI   ITYPE,C'A'         FOOL UNSPAN INTO USING GET
         JAS   R14,UNSPAN         RECONSTRUCT A SPANNED RECORD
         STC   R2,ITYPE           RESTORE ITYPE
         L     R5,VSAMINBF        R5=UNSPANNED RECORD
         AHI   R5,-10             BACK TO BUFFER START
         MVC   0(10,R5),WORK1+17  MOVE RRN
         J     UNLDPREP           EXIT
*
UNLDNRRF DS    0H
* FIXED UNSPANNED RRDS
         MVC   0(10,R5),WORK1+17  MOVE RRN
         L     R11,VXXXLMAX       R11=MAXIMUM RECORD LENGTH
         LA    R10,10(R5)         R10=DESTINATION
         LR    R0,R8              R0=SOURCE
         LR    R1,R11             R1=LENGTH
         MVCL  R10,R0             MOVE FIXED RRDS RECORD
UNLDPREP DS    0H
         AGSI  UNLDRRN,1          BUMP RRN
         LR    R8,R5              R8=CONSTRUCTED RECORD
         J     UNLDPUT            EXIT
*
UNLDNRR2 DS    0H
* ESDS OR KSDS
* FIXED OR VARIABLE
         L     R8,RPTRREC@        R8=OFFSET TO RECORD
         AR    R8,R6              R8=RECORD ADDRESS
         TM    RPTRFLGS,RPTR_SEG  FIRST SEGMENT ?
         JNO   UNLDPUT            EXIT IF NOT
* SPANNED
         IC    R2,ITYPE           SAVE ITYPE
         MVI   ITYPE,C'A'         FOOL UNSPAN INTO USING GET
         JAS   R14,UNSPAN         RECONSTRUCT A SPANNED RECORD
         STC   R2,ITYPE           RESTORE ITYPE
         L     R8,VSAMINBF        R8=UNSPANNED RECORD
UNLDPUT  DS    0H
         TM    VXXXFLG1,VCLRVREC  VARIABLE ?
         JNO   UNLDFIXP           EXIT IF NOT
* VARIABLE, TEST LIMITS
         L     R3,0(R8)           R3=RLF
* TESTS DONE FOR RRDS, JUST DO RLF TO RDW
         TM    VXXXFLG1,VCLRRRDS  RRDS ?
         JO    UNLDDNRR           EXIT IF IT IS
         CFI   R3,32767           MAX RDW BUSTED ?
         JH    BADUNLD            ERROR IF IT IS
         AHI   R3,-4              ACTUAL RECORD LENGTH
         C     R3,VXXXLMAX        LARGER THAN MAX RECORD LENGTH ?
         JH    BADUNLD            ERROR IF IT IS
         AHI   R3,4               RESTORE LENGTH (INC. RDW)
UNLDDNRR DS    0H
         SLL   R3,16              CONVERT TO RDW
         ST    R3,0(R8)           SAVE RDW
UNLDFIXP DS    0H
         PUT   OUTFILEQ,(R8)      UNLOAD QSAM RECORD
         ASI   AIXNTRAK,1         COUNT BASE RECORDS
UNLDBUMP DS    0H
         AHI   R9,RPTRLENG        BUMP DATA RPTR POINTER
         J     UNLDBLCK           LOOP
*
UNLDENDB DS    0H
* END OF DATA RPTR'S
         LG    R2,BHDRNEXT        R2=NEXT DATA BLOCK
         CGHI  R2,-1              ANY NEXT DATA BLOCK ?
         JNE   UNLDLOOP           LOOP IF THERE IS
* WTO BASE CLUSTER RECORDS
         L     R1,AIXNTRAK        R1=NO. OF BASE CLUSTER RECORDS
         CVD   R1,WORK1           CONVERT TO DECIMAL
         ED    BASERECS,WORK1+2   EDIT NO. OF BASE CLUSTER RECORDS
         WTO   MF=(E,WTOBASRC)    SHOW IT
* NOTED FOR RPI, MACRF=PM DOESN'T WRITE AN EOF AT CLOSE
* SO WE WILL HERE TO MAKE THE LOAD INPUT=UNLOAD OUTPUT
         LA    R2,1               R2=1 FOR EOF
         ST    R2,OUTFILEQ+DCBBLKSIF-IHADCB SAVE EOF LENGTH
         ST    R2,OUTFILEQ+DCBLRECLF-IHADCB SAVE EOF LENGTH
         MVI   OUTFILEQ+DCBRECFM-IHADCB,DCBRECFM_F SET IN DCB
         PUT   OUTFILEQ,UNLDEOF   UNLOAD EOF
         CLOSE OUTFILEQ           CLOSE OUTPUT QSAM DCB
         CLOSE DTAIN              CLOSE INPUT VSAM DCB
         J     PROGEND            EXIT
         DROP  R9
*
*
VERIFY   DS    0H
**********
* VERIFY *
**********
         LARL  R1,VERBASES        BASE-FREE
         STM   R12,R13,0(R1)      SAVE MAINLINE BASES R12, R13
         LARL  R13,VERIFY         R13=BASE 1
         LAY   R10,4096(R13)      R10=BASE 2
         LAY   R11,4096(R10)      R11=BASE 3
         USING VERIFY,R13,R10,R11
***************
* VERIFY DATA *
***************
* BASES
*    R2  FOR ZVSAMRPT
*    R6 HIGH FOR VSAMDATA ) SWAPPED AS
*    R6 LOW  FOR VSAMPRFX )            NEEDED
*
* OPEN INPUT VSAM DTA
         L     R14,VEREOFAD       R14=DATA EODAD ADDRESS
         ST    R14,DTAIN+DCBEODAD-IHADCB SAVE EODAD
         OPEN  (DTAIN,(INPUT))    OPEN VSAM DATA INPUT DCB
         LTR   R15,R15            OK ?
         JNZ   BADOPEND           ERROR IF NOT
* SHOW INPUT DTA FILE OPENED: PATH
         MVC   OPENMSG,WTOINPVD   MOVE 'INPUT DTA OPENED' MSG
         L     R1,GETENVI         R1=VSAM INPUT PATH ADDRESS
         JAS   R14,OPENWTOV       WTO OPEN FILE
* SET UP THE INFO LINE AND DISPLAY IT
         LARL  R4,WTOINFSV        R4=BASE FOR INFO LINE
         USING WTOINFDS,R4
         CLI   ITYPE,C'A'         IS CLUSTER AN AIX ?
         JNE   VERNAIXU           EXIT IF NOT
* AIX
         MVC   WTOXXDS(4),CNSTAIXU SET AIX UNIQUE
         TM    VXXXFLG1,VAIXUKEY  UNIQUE ?
         JO    VERSPANU           EXIT IF IT IS
* AIX NON-UNIQUE
         MVHHI WTORECFM,C'V '     SET AIX AS VARIABLE
         MVI   WTOXXDS+3,C'N'     SET AIX NON-UNIQUE
         MVC   WTOVRFX(8),CNSTVARB SET VARIABLE
         MVC   WTONSPAN(10),CNSTSPAN SET SPANNED
         J     VERSPANU           EXIT
*
VERNAIXU DS    0H
         TM    VXXXFLG1,VCLRKSDS  KSDS ?
         JO    VERXXDSU           EXIT IF IT IS
         MVHHI WTOXXDS,C'RR'      SET RRDS
         TM    VXXXFLG1,VCLRRRDS  RRDS ?
         JO    VERXXDSU           EXIT IF IT IS
         MVHHI WTOXXDS,C'ES'      SET ESDS
VERXXDSU DS    0H
         TM    VXXXFLG1,VCLRVREC  VARIABLE ?
         JNO   VERNVARU           EXIT IF NOT
         MVC   WTOVRFX(8),CNSTVARB SET VARIABLE
VERNVARU DS    0H
         TM    VXXXFLG1,VCLRSPAN  SPANNED ?
         JNO   VERSPANU           EXIT IF NOT
         MVC   WTONSPAN(10),CNSTSPAN SET SPANNED
         DROP  R4
VERSPANU DS    0H
* DISPLAY INFO LINE
         WTO   MF=(E,WTOINFOV)    SHOW IT
* GETMAIN 4K FOR DATA PREFIX BLOCK
         LHI   R1,4096            R1=4K
         GETMAIN RU,LV=(R1)
         ST    R1,VSAMPRFX        SAVE ADDRESS
         LR    R6,R1              R6=VSAMPRFX
* GET DATA PREFIX BLOCK
         LHI   R2,4096            R2=PREFIX BLOCKSIZE
         ST    R2,DTAIN+DCBBLKSIF-IHADCB SAVE BLKSIZE
         ST    R2,DTAIN+DCBLRECLF-IHADCB SAVE LRECL
* R6 IS NOW VSAMPRFX
         GET   DTAIN,(R6)         GET DATA PREFIX BLOCK
         USING ZVSAMHDR,R6
         USING ZVSAMPFX,ZVSAMHDR+BHDRLENG
         USING ZVSAMCTR,ZVSAMPFX+PFXLENG
         MVC   PXXFFLGS,PFXFFLGS  COPY DATA PFXFFLGS
* SET AIXNBSXL (ONLY NEEDED FOR NON-UNIQUE AIX)
         MVHI  AIXNBSXL,8         ASSUME ESDS
         TM    PFXFFLGS,PFX_ESDS  ESDS ?
         JO    VERESDS            EXIT IF NOT
         L     R2,PFXRCLEN        R2=RECORD LENGTH (AIX+BASE)
         S     R2,PFXKYLEN        -AIX KEYLENGTH=BASE KEYLENGTH
         ST    R2,AIXNBSXL        SAVE IT
VERESDS  DS    0H
* ONLY NEED THESE FOR NON-UNIQUE AIX
         L     R2,PFXBLKSZ        R2=(ADJUSTED) DATA BLKSIZE
         GETMAIN RU,LV=(R2)
         ST    R1,VSAMELIX        SAVE VSAM ELIX BLOCK ADDRESS
         GETMAIN RU,LV=(R2)
         ST    R1,VSAMSEGM        SAVE VSAM SEGMENT BLOCK ADDRESS
****************************
* VERIFY DATA PREFIX BLOCK *
****************************
* ERRORS ARE SHOWN AS OFFSET/CORRECT VALUE/INCORRECT VALUE IN HEX
* BHDREYE
         CLC   BHDREYE,CNSTHDR    VERIFY BHDREYE ?
         JE    VERHEYEK           EXIT IF IT IS
* BHDREYE IN ERROR
         LA    R9,3               R9=LENGTH TO DISPLAY
         LA    R4,BHDREYE         R4=ADDRESS OF INCORRECT VALUE
         LA    R5,CNSTHDR         R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERHEYEK DS    0H
         ASI   VEROFFST,3+1       BUMP OFFSET, MISS SEQ#
* BHDRVER
         CLI   BHDRVER,BHDR_V2    VERSION 2 ?
         JE    VERVERK            EXIT IF IT IS
