         LA    R4,CTREYE          R4=ADDRESS OF INCORRECT VALUE
         LA    R5,VERCTEYE        R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERCTEYK DS    0H
*###CTR CHECKS GO HERE
* BFTREYE AND SEQ#
         L     R7,VSAMPRFX        R7=PREFIX BLOCK ADDRESS
         AHI   R7,4096-BFTRLENG   R7=ZVSAMFTR
         USING ZVSAMFTR,R7
         MVHI  VEROFFST,4096-BFTRLENG SET OFFSET
* BFTREYE
         CLC   BFTREYE,CNSTFTR    VERIFY BFTREYE ?
         JE    VERFEYEK           EXIT IF IT IS
* BFTREYE IN ERROR
         LA    R9,3               R9=LENGTH TO DISPLAY
         LA    R4,BFTREYE         R4=ADDRESS OF INCORRECT VALUE
         LA    R5,CNSTFTR         R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERFEYEK DS    0H
         ASI   VEROFFST,3         BUMP OFFSET
* BHDRSEQ#=BFTRSEQ#
         CLC   BHDRSEQ#,BFTRSEQ#  SEQ# MATCHES ?
         JE    VERSEQOK           EXIT IF THEY DO
* SEQ# IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,BHDRSEQ#        R4=ADDRESS OF BHDRSEQ#
         LA    R5,BFTRSEQ#        R5=ADDRESS OF BFTRSEQ#
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERSEQOK DS    0H
         DROP  R7
* VERIFY BLOCK COUNTS AND CHAINS
         L     R2,PFXBLKSZ        R2=(ADJUSTED) DATA BLKSIZE
         ST    R2,DTAIN+DCBBLKSIF-IHADCB SAVE BLKSIZE
         ST    R2,DTAIN+DCBLRECLF-IHADCB SAVE LRECL
         GETMAIN RU,LV=(R2)
         ST    R1,VSAMDATA        SAVE VSAM DATA BLOCK ADDRESS
         LFH   R6,VSAMDATA        R6 HIGH=VSAMDATA
         RLLG  R6,R6,32           SWAP VSAMDATA/VSAMPRFX
* R6 IS NOW VSAMDATA
         LGHI  R3,-256            BLOCK NUMBER STARTS AT ZERO
VERBLOOP DS    0H
         GET   DTAIN,(R6)         GET DATA BLOCK (EOF TO VEREOF)
         AGHI  R3,256             BUMP BLOCK NUMBER
* CHECK HDR/FTR SEQ# MATCH
         CLC   BHDREYE,CNSTHDR    VERIFY BHDREYE ?
         JNE   VERHFSBD           EXIT IF NOT
         LR    R7,R2              R7=DATA BLKSIZE
         AHI   R7,-BFTRLENG       R7=OFFSET OF FTR
         AR    R7,R6              R7=ADDRESS OF FTR
         CLC   0(3,R7),CNSTFTR    VERIFY BFTREYE ?
         JNE   VERHFSBD           EXIT IF NOT
         CLC   BHDREYE+3(1),3(R7) SEQ# MATCH ?
         JE    VERHFSOK           EXIT IF THEY DO
VERHFSBD DS    0H
* BAD HDR/FTR/SEQ#
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,8               R9=LENGTH
         LA    R5,BHDRSELF        BASE-FREE
         LA    R8,VERHFSXL        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,4               R9=LENGTH
         LA    R5,BHDREYE         BASE-FREE
         LA    R8,VERHFSHD        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,BFTRLENG        R9=LENGTH
         LA    R8,VERHFSFT        R8=DESTINATION ADDRESS
         TROT  R8,R7,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERHF)    DISPLAY HDR/FTR/SEQ# ERROR
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
VERHFSOK DS    0H
* COUNT BLOCK TYPES AND VERIFY BHDRSELF
         CLI   BHDRFLG1,BHDR_MAP  IS IT SPACEMAP ?
         JNE   VERNSPAC           EXIT IF NOT
* SPACEMAP BLOCK
         AGSI  VERSPCCT,1         COUNT SPACEMAP BLOCKS
* BHDRSELF CHECK
         CG    R3,BHDRSELF        MATCH BHDRSELF ?
         JE    VERBLOOP           EXIT IF IT DOES
* BHDRSELF IN ERROR
         JAS   R14,VERWTOSF       SHOW BHDRSELF ERROR MESSAGE
         J     VERBLOOP           LOOP
*
VERNSPAC DS    0H
         TM    BHDRFLG1,BHDR_SEG  IS IT SEGMENT ?
         JNO   VERNSEGM           EXIT IF NOT
* SEGMENT BLOCK
         AGSI  VERSEGCT,1         COUNT SEGMENT BLOCKS
* BHDRSELF CHECK
         CG    R3,BHDRSELF        MATCH BHDRSELF ?
         JE    VERBLOOP           LOOP IF IT DOES
* BHDRSELF IN ERROR
         JAS   R14,VERWTOSF       SHOW BHDRSELF ERROR MESSAGE
         J     VERBLOOP           LOOP
*
VERNSEGM DS    0H
         TM    BHDRFLG2,BHDR_ELX  IS IT ELIX ?
         JNO   VERNELIX           EXIT IF NOT
* SEGMENT BLOCK
         AGSI  VERELXCT,1         COUNT ELIX BLOCKS
* BHDRSELF CHECK
         CG    R3,BHDRSELF        MATCH BHDRSELF ?
         JE    VERBLOOP           LOOP IF IT DOES
* BHDRSELF IN ERROR
         JAS   R14,VERWTOSF       SHOW BHDRSELF ERROR MESSAGE
         J     VERBLOOP           LOOP
*
* DATA BLOCK
VERNELIX DS    0H
         AGSI  VERDTACT,1         COUNT DATA BLOCKS
* BHDRSELF CHECK
         CG    R3,BHDRSELF        MATCH BHDRSELF ?
         JE    VERBLOOP           LOOP IF IT DOES
* BHDRSELF IN ERROR
         JAS   R14,VERWTOSF       SHOW BHDRSELF ERROR MESSAGE
         J     VERBLOOP           LOOP
*
VEREOF   DS    0H
* PFXHXLRA CHECK
         RLLG  R6,R6,32           SWAP VSAMDATA/VSAMPRFX
* R6 IS NOW VSAMPRFX
         CG    R3,PFXHXLRA        MATCHES PFXHXLRA ?
         JE    VERHXLOK           EXIT IF IT DOES
* PFXHXLRA IN ERROR
         STG   R3,VERWORK1        SAVE COUNT
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,8               R9=LENGTH
         LA    R5,PFXHXLRA        BASE-FREE
         LA    R8,VERHXLRA        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,8               R9=LENGTH
         LA    R5,VERWORK1        BASE-FREE
         LA    R8,VERHXCNT        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERHX)    DISPLAY PFXHXLRA ERROR
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
VERHXLOK DS    0H
* CHASE THE CHAINS AND CHECK THE COUNTS AND TYPES
* INCLUDING LOOP PROTECTION
*
* CHECK BHDR#REC/RPTREND/FREESPACE
*
* SPACEMAP BLOCKS HAVE BIT PATTERN CHECKS
*
* DATA FORWARD SCAN
         LA    R4,VERDF           R4=TYPE/DIRECTION
         JAS   R14,VERCHAIN       CHECK CHAIN
* DATA BACKWARD SCAN
         LA    R4,VERDB           R4=TYPE/DIRECTION
         JAS   R14,VERCHAIN       CHECK CHAIN
         CGHSI PFXBSEGM,-1        ANY SEGMENT BLOCKS ?
         JE    VERNOSEG           EXIT IF NONE
* SEGMENT FORWARD SCAN
         LA    R4,VERGF           R4=TYPE/DIRECTION
         JAS   R14,VERCHAIN       CHECK CHAIN
* SEGMENT BACKWARD SCAN
         LA    R4,VERGB           R4=TYPE/DIRECTION
         JAS   R14,VERCHAIN       CHECK CHAIN
VERNOSEG DS    0H
* SPACEMAP FORWARD SCAN
         LA    R4,VERSF           R4=TYPE/DIRECTION
         JAS   R14,VERCHAIN       CHECK CHAIN
* SPACEMAP BACKWARD SCAN
         LA    R4,VERSB           R4=TYPE/DIRECTION
         JAS   R14,VERCHAIN       CHECK CHAIN
         CLOSE DTAIN              CLOSE INPUT VSAM DCB
****************
* VERIFY INDEX *
****************
         MVHI  VEROFFST,0         SET OFFSET TO ZERO
* OPEN INPUT VSAM IDX
         LA    R14,VSAMIDXI       R14=INDEX DSNAME ADDRESS
         ST    R14,DTAIN+DCBDSNAM-IHADCB SAVE INDEX DSNAME ADDRESS
         L     R14,VEIEOFAD       R14=INDEX EODAD ADDRESS
         ST    R14,DTAIN+DCBEODAD-IHADCB SAVE EODAD
         OPEN  (DTAIN,(INPUT))    OPEN VSAM INDEX INPUT DCB
         LTR   R15,R15            OK ?
         JNZ   BADOPEND           ERROR IF NOT
         MVI   WTOVERH1,X'FF'     MARK DATA HEADER DONE
         MVI   WTOVERH2,0         MARK INDEX HEADER POSSIBLE
* SHOW INPUT IDX FILE OPENED: PATH
         MVC   OPENMSG,WTOINPVI   MOVE 'INPUT IDX OPENED' MSG
         L     R1,GETENVI         R1=VSAM INPUT PATH ADDRESS
         JAS   R14,OPENWTOV       WTO OPEN FILE
* SET UP THE INFO LINE AND DISPLAY IT
         LARL  R4,WTOINFSV        R4=BASE FOR INFO LINE
         USING WTOINFDS,R4
         CLI   ITYPE,C'A'         IS OUTPUT CLUSTER AN AIX ?
         JNE   VEINAIXU           EXIT IF NOT
* AIX
         MVC   WTOXXDS(4),CNSTAIXU SET AIX UNIQUE
         TM    VXXXFLG1,VAIXUKEY  UNIQUE ?
         JO    VEISPANU           EXIT IF IT IS
* AIX NON-UNIQUE
         MVHHI WTORECFM,C'V '     SET AIX AS VARIABLE
         MVI   WTOXXDS+3,C'N'     SET AIX NON-UNIQUE
         MVC   WTOVRFX(8),CNSTVARB SET VARIABLE
         MVC   WTONSPAN(10),CNSTSPAN SET SPANNED
         J     VEISPANU           EXIT
*
VEINAIXU DS    0H
         TM    VXXXFLG1,VCLRKSDS  KSDS ?
         JO    VEIXXDSU           EXIT IF IT IS
         MVHHI WTOXXDS,C'RR'      SET RRDS
         TM    VXXXFLG1,VCLRRRDS  RRDS ?
         JO    VEIXXDSU           EXIT IF IT IS
         MVHHI WTOXXDS,C'ES'      SET ESDS
VEIXXDSU DS    0H
         TM    VXXXFLG1,VCLRVREC  VARIABLE ?
         JNO   VEINVARU           EXIT IF NOT
         MVC   WTOVRFX(8),CNSTVARB SET VARIABLE
VEINVARU DS    0H
         TM    VXXXFLG1,VCLRSPAN  SPANNED ?
         JNO   VEISPANU           EXIT IF IT IS
         MVC   WTONSPAN(10),CNSTSPAN SET SPANNED
         DROP  R4
VEISPANU DS    0H
* DISPLAY INFO LINE
         WTO   MF=(E,WTOINFOV)    DISPLAY INFO LINE
* GET INDEX PREFIX BLOCK
         LHI   R2,4096            R2=PREFIX BLOCKSIZE
         ST    R2,DTAIN+DCBBLKSIF-IHADCB SAVE BLKSIZE
         ST    R2,DTAIN+DCBLRECLF-IHADCB SAVE LRECL
* R6 IS VSAMPRFX
         GET   DTAIN,(R6)         GET INDEX PREFIX BLOCK
* VERIFY INDEX PREFIX BLOCK
* ERRORS ARE SHOWN AS OFFSET/CORRECT VALUE/INCORRECT VALUE IN HEX
* BHDREYE
         CLC   BHDREYE,CNSTHDR    VERIFY BHDREYE ?
         JE    VEIHEYEK           EXIT IF IT IS
* BHDREYE IN ERROR
         LA    R9,3               R9=LENGTH TO DISPLAY
         LA    R4,BHDREYE         R4=ADDRESS OF INCORRECT VALUE
         LA    R5,CNSTHDR         R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIHEYEK DS    0H
         ASI   VEROFFST,3+1       BUMP OFFSET, MISS SEQ#
* BHDRVER
         CLI   BHDRVER,BHDR_V2    VERSION 2 ?
         JE    VEIVERK            EXIT IF IT IS
* BHDRVER IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,BHDRVER         R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIVERK  DS    0H
         ASI   VEROFFST,1         BUMP OFFSET
* BHDRFLG1
         CLI   BHDRFLG1,BHDR_PFX  PREFIX BLOCK ?
         JE    VEIFLG1K           EXIT IF IT IS
* BHDRFLG1 IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,BHDRFLG1        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIFLG1K DS    0H
         ASI   VEROFFST,1         BUMP OFFSET
* BHDRFLG2
         CLI   BHDRFLG2,0         FLG2=ZERO ?
         JE    VEIFLG2K           EXIT IF IT IS
* BHDRFLG2 IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,BHDRFLG2        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIFLG2K DS    0H
         ASI   VEROFFST,1         BUMP OFFSET
* BHDR#REC
         CLI   BHDR#REC,0         ANY RECORDS ?
         JE    VEI#RECK           EXIT IF NONE
* BHDR#REC IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,BHDR#REC        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEI#RECK DS    0H
         ASI   VEROFFST,1         BUMP OFFSET
* BHDRXLVL
         CLI   BHDRXLVL,0         INDEX LEVEL=0 ?
         JE    VEIBLVLK           EXIT IF IT IS
* BHDRXLVL IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,BHDRXLVL        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIBLVLK DS    0H
         ASI   VEROFFST,1         BUMP OFFSET
* BHDRSELF
         CGHSI BHDRSELF,-1        SELF=FOXES ?
         JE    VEISELFK           EXIT IF IT IS
* BHDRSELF IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LA    R4,BHDRSELF        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEISELFK DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
* BHDRNEXT
         CGHSI BHDRNEXT,-1        NEXT=FOXES ?
         JE    VEINEXTK           EXIT IF IT IS
* BHDRNEXT IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LA    R4,BHDRNEXT        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEINEXTK DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
* BHDRPREV
         CGHSI BHDRPREV,-1        PREV=FOXES ?
         JE    VEIPREVK           EXIT IF IT IS
* BHDRPREV IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LA    R4,BHDRPREV        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIPREVK DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
* BHDRFRE@
         LA    R5,BHDRLENG+PFXLENG+CTRLENG CALC EXPECTED OFFSET
         LH    R4,PFXDNAM@        R4=DATA FILENAME OFFSET
         AR    R4,R6              R4=DATA FILENAME POINTER
         AH    R5,0(R4)           ADD LENGTH
         LH    R4,PFXDPAT@        R4=DATA PATH OFFSET
         AR    R4,R6              R4=DATA PATH POINTER
         AH    R5,0(R4)           ADD LENGTH
         LH    R4,PFXXNAM@        R4=INDEX FILENAME OFFSET
         AR    R4,R6              R4=INDEX FILENAME POINTER
         AH    R5,0(R4)           ADD LENGTH
         LH    R4,PFXXPAT@        R4=INDEX PATH OFFSET
         AR    R4,R6              R4=INDEX PATH POINTER
         AH    R5,0(R4)           ADD LENGTH
         LR    R2,R5              SAVE LENGTH
         ST    R5,VERWORK1        SAVE IT
         CLC   BHDRFRE@,VERWORK1  CORRECT VALUE ?
         JE    VEIFRE@K           EXIT IF IT IS
* BHDRFRE@ IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,BHDRFRE@        R4=ADDRESS OF INCORRECT VALUE
         LA    R5,VERWORK1        R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIFRE@K DS    0H
         ASI   VEROFFST,4         BUMP OFFSET
* BHDRFREE
         LHI   R5,4096            R5=PREFIX BLOCKSIZE
         AHI   R5,-BFTRLENG       -FTR LENGTH
         SR    R5,R2              -CALCULATED BHDRFRE@
         ST    R5,VERWORK1        SAVE IT
         CLC   BHDRFREE,VERWORK1  CORRECT VALUE ?
         JE    VEIFREEK           EXIT IF IT IS
* BHDRFREE IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,BHDRFREE        R4=ADDRESS OF INCORRECT VALUE
         LA    R5,VERWORK1        R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIFREEK DS    0H
         ASI   VEROFFST,4+7       BUMP OFFSET+PADDING
* PFXEYE
         CLC   PFXEYE,VERPXEYE    EYE=zPFX ?
         JE    VEIPXEYK           EXIT IF IT IS
* PFXEYE IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,PFXEYE          R4=ADDRESS OF INCORRECT VALUE
         LA    R5,VERPXEYE        R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIPXEYK DS    0H
         ASI   VEROFFST,4         BUMP OFFSET
* PFXRCLEN=8(ESDS/RRDS) OR KEYLEN(KSDS)+8(XLRA)
         CLI   PXXFFLGS,PFX_LDS   LDS ?
         JE    VEIRCLOK           EXIT IF IT IS
         L     R14,VXXXKLEN       R14=KEY LENGTH (KSDS)
         TM    PXXFFLGS,PFX_KSDS  KSDS ?
         JO    VEIRCLLL           EXIT IF IT IS
         LA    R14,8              R14=8(XLRA) FOR ESDS/RRDS
VEIRCLLL DS    0H
         AHI   R14,8              +8 FOR XLRA
         C     R14,PFXRCLEN       CORRECT ?
         JE    VEIRCLOK           EXIT IF IT IS
* PFXRCLEN IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,PFXRCLEN        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIRCLOK DS    0H
         ASI   VEROFFST,4         BUMP OFFSET
         TM    PXXFFLGS,PFX_KSDS  KSDS ?
         JO    VEIKEYLO           EXIT IF IT IS
* NOT KSDS, MISS PFXKYLEN AND PFXKYOFF
         ASI   VEROFFST,4+4       BUMP OFFSET (PFXKYLEN+PFXKYOFF)
         J     VEIDVOL            EXIT
********EGQTV    DC    C'EGQTV '          ###TRACE ON
********NOTRACE  DC    C' '               ###TRACE OFF
*
VEIKEYLO DS    0H
* PFXKYLEN MATCHES CATALOG (KSDS ONLY)
         CLC   PFXKYLEN,VXXXKLEN  MATCHES CATALOG ?
         JE    VEIKYLOK           EXIT IF IT DOES
* PFXKYLEN IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,PFXKYLEN        R4=ADDRESS OF INCORRECT VALUE
         LA    R5,VXXXKLEN        R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIKYLOK DS    0H
         ASI   VEROFFST,4         BUMP OFFSET
* PFXKYOFF=0 (KSDS ONLY)
         CHSI  PFXKYOFF,0         PFXKYOFF=ZERO ?
         JE    VEIKYOOK           EXIT IF IT IS
* PFXKYOFF IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,PFXKYOFF        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIKYOOK DS    0H
         ASI   VEROFFST,4         BUMP OFFSET
VEIDVOL  DS    0H
* PFXDVOL@
         CHHSI PFXDVOL@,-1        DVOL@=FOXES ?
         JE    VEIDVOLK           EXIT IF IT IS
* PFXDVOL@ IN ERROR
         LA    R9,2               R9=LENGTH TO DISPLAY
         LA    R4,PFXDVOL@        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIDVOLK DS    0H
* NOT DOING DNAM@, DPAT@ HERE
         ASI   VEROFFST,2+2+2     BUMP OFFSET (DVOL@+DNAM@+DPAT@)
* PFXXVOL@
         CHHSI PFXXVOL@,-1        XVOL@=FOXES ?
         JE    VEIXVOLK           EXIT IF IT IS
* PFXXVOL@ IN ERROR
         LA    R9,2               R9=LENGTH TO DISPLAY
         LA    R4,PFXXVOL@        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIXVOLK DS    0H
         ASI   VEROFFST,2         BUMP OFFSET
* MATCH XPAT/XNAM WITH VSAMIDXI
* DISPLAY 1ST 32 BYTES IF MISMATCH
         LH    R4,PFXXPAT@        R4=INDEX PATH OFFSET
         AR    R4,R6              R4=INDEX PATH POINTER
         LH    R5,0(R4)           R5=LENGTH (INC. LL)
         AHI   R4,2               BUMP PAST LENGTH
         AHI   R5,-2-1            LENGTH-2, -1 FOR EXECUTE
         LA    R2,VERFILE         R2=PATH\FILE AREA
         EXRL  R5,VERMOVPF        MOVE PATH
         LA    R2,1(R2,R5)        R2=POINT AFTER PATH
         MVI   0(R2),C'\'         INSERT BACKSLASH
         AHI   R2,1               BUMP POINTER
         LH    R4,PFXXNAM@        R4=INDEX FILENAME OFFSET
         AR    R4,R6              R4=INDEX FILENAME POINTER
         LH    R5,0(R4)           R5=LENGTH (INC. LL)
         AHI   R4,2               BUMP PAST LENGTH
         AHI   R5,-2-1            LENGTH-2, -1 FOR EXECUTE
         EXRL  R5,VERMOVPF        MOVE FILENAME
         SGR   R0,R0              SET STOPPER TO X'00'
         LA    R4,VSAMIDXI        R4=PATH\FILE OPENED
         LA    R5,VERFILE         R5=PATH\FILE IN PFX
         CLST  R4,R5              MATCH ?
         JE    VEIXPATK           EXIT IF IT DOES
* PFXXPAT@/XNAM@ IN ERROR
         MVI   WTOCOREC,C' '      CLEAR
         MVC   WTOCOREC+1(31),WTOCOREC  WTOCOREC
         LA    R5,VSAMIDXI        R5=ADDRESS OF CORRECT VALUE
* WTO STOPS AT X'00', MUST MOVE BYTE-BY-BYTE
         LA    R1,32              R1=LOOP LIMIT
VEILOOPC DS    0H
         CLI   0(R5),0            NULL STOPPER ?
         JE    VEICORDN           EXIT IF IT IS
         MVC   0(1,R15),0(R5)     MOVE BYTE
         AHI   R15,1              BUMP POINTER
         AHI   R5,1               BUMP POINTER
         JCT   R1,VEILOOPC        LOOP
*
VEICORDN DS    0H
         MVI   WTOINCOR,C' '      CLEAR
         MVC   WTOINCOR+1(31),WTOINCOR  WTOINCOR
         LA    R4,VERFILE         R4=ADDRESS OF INCORRECT VALUE
         LA    R1,32              R1=LOOP LIMIT
VEILOOPI DS    0H
         CLI   0(R4),0            NULL STOPPER ?
         JE    VEIINCDN           EXIT IF IT IS
         MVC   0(1,R15),0(R4)     MOVE BYTE
         AHI   R15,1              BUMP POINTER
         AHI   R4,1               BUMP POINTER
         JCT   R1,VEILOOPI        LOOP
*
VEIINCDN DS    0H
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         JAS   R14,VERSHOWO       BUILD OFFSET AND WTO
VEIXPATK DS    0H
         ASI   VEROFFST,2+2       BUMP OFFSET (XNAM@+XPAT@)
* PFXIXLVL
* COUNT LEVELS AND CHECK
         SR    R0,R0              R0=LEVEL COUNT
         LA    R1,15              R1=NO. OF LEVELS TO CHECK
         LA    R5,PFXBLVL1        R5=LEVEL XLRA
VEIIXLOP DS    0H
         CGHSI 0(R5),-1           GOT A LEVEL ?
         JE    VEIIXDUN           EXIT IF NOT
         AHI   R5,16              BUMP LEVEL POINTER
         AHI   R0,1               COUNT LEVELS
         JCT   R1,VEIIXLOP        LOOP
*
VEIIXDUN DS    0H
         SLL   R0,24              SHIFT TO TOP BYTE
         ST    R0,VERWORK1        SAVE ACTUAL NO. OF LEVELS
         CLC   PFXIXLVL,VERWORK1  PFXIXLVL CORRECT ?
         JE    VEIIXLVK           EXIT IF IT IS
* PFXIXLVL IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,PFXIXLVL        R4=ADDRESS OF INCORRECT VALUE
         LA    R5,VERWORK1        R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIIXLVK DS    0H
         ASI   VEROFFST,1         BUMP OFFSET
* PFXALTHR
         CLI   PFXALTHR,0         PFXALTHR=0 ?
         JE    VEIALTHK           EXIT IF IT IS
* PFXALTHR IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,PFXALTHR        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIALTHK DS    0H
         ASI   VEROFFST,1         BUMP OFFSET
* PFXBLKSZ
         CHSI  PFXBLKSZ,0         PFXBLKSZ NOT ZERO ?
         JNE   VEIBLKSK           EXIT IF NOT
* PFXBLKSZ IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,PFXBLKSZ        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIBLKSK DS    0H
         ASI   VEROFFST,4         BUMP OFFSET
* TEST THE NEXT XLRAS FOR VALIDITY...NOT FOXES AND RIGHTMOST BYTE=0
*    HXLRA, BMAP, EMAP, MAPNW
         LA    R2,4               R2=NO. OF FIELDS
         LA    R7,PFXHXLRA        R7=ADDRESS OF START VALUE
VEIXLRA1 DS    0H
         CLI   7(R7),0            RIGHTMOST BYTE ZERO ?
         JNE   VEIXLRAE           ERROR IF NOT
         MVI   7(R7),X'FF'        TEMP CHANGE
         CGHSI 0(R7),-1           FIELD NOT FOXES ?
         MVI   7(R7),X'00'        RESET CHANGE
         JNE   VEIXLRAK           EXIT IF NOT
VEIXLRAE DS    0H
* FIELD IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LR    R4,R7              R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIXLRAK DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
         AHI   R7,8               BUMP FIELD POINTER
         JCT   R2,VEIXLRA1        LOOP
*
* TEST THE FOLLOWING FOR FOXES
*    BDATA,EDATA,BSEGM,ESEGM
         LA    R2,4               R2=NO. OF FIELDS
         LA    R7,PFXBDATA        R7=ADDRESS OF START VALUE
VEIXLRA2 DS    0H
         CGHSI 0(R7),-1           FIELD NOT FOXES ?
         JE    VEIXLRK2           EXIT IF IT IS
* FIELD IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LR    R4,R7              R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIXLRK2 DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
         AHI   R7,8               BUMP FIELD POINTER
         JCT   R2,VEIXLRA2        LOOP
*
* TEST THE NEXT XLRAS FOR VALIDITY...NOT FOXES AND RIGHTMOST BYTE=0
*    ROOT, BLVL0, ELVL0
         LA    R2,3               R2=NO. OF FIELDS
         LA    R7,PFXROOT         R7=ADDRESS OF START VALUE
VEIROOTL DS    0H
         CLI   7(R7),0            RIGHTMOST BYTE ZERO ?
         JNE   VEIROOTE           ERROR IF NOT
         MVI   7(R7),X'FF'        TEMP CHANGE
         CGHSI 0(R7),-1           FIELD NOT FOXES ?
         MVI   7(R7),X'00'        RESET CHANGE
         JNE   VEIROOTK           EXIT IF NOT
VEIROOTE DS    0H
* FIELD IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LR    R4,R7              R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIROOTK DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
         AHI   R7,8               BUMP FIELD POINTER
         JCT   R2,VEIROOTL        LOOP
*
* CHECK LEVELS, ONCE FOXES THE REST ARE FOXES
* BLVLn AND ELVLn ARE BOTH FOXES, OR BOTH NOT FOXES
         LA    R2,15              R2=NO. OF FIELD PAIRS
         LA    R7,PFXBLVL1        R7=ADDRESS OF START VALUE
VEILEVLP DS    0H
         CGHSI 0(R7),-1           FIELD IS FOXES ?
         JE    VEILEVFX           EXIT IF IT IS
* LEVEL PAIR MUST BOTH BE VALID
         CLI   7(R7),0            RIGHTMOST BYTE ZERO ?
         JE    VEILEVK1           EXIT IF IT IS
* FIELD IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LR    R4,R7              R4=ADDRESS OF INCORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEILEVK1 DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
         AHI   R7,8               BUMP FIELD POINTER
         CLI   7(R7),0            RIGHTMOST BYTE ZERO ?
         JE    VEILEVK2           EXIT IF IT IS
* FIELD IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LR    R4,R7              R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEILEVK2 DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
         AHI   R7,8               BUMP FIELD POINTER
         JCT   R2,VEILEVLP        LOOP
*
         J     VEIFRSPC           EXIT
*
VEILEVFX DS    0H
* 1ST OF PAIR IS FOXES, CHECK THE REMAINING PAIRS
         AR    R2,R2              R2=REMAINING NO. OF FIELDS
VEILEVFP DS    0H
         CGHSI 0(R7),-1           FIELD IS FOXES ?
         JE    VEILEVFK           EXIT IF IT IS
* FIELD IN ERROR
         LA    R9,8               R9=LENGTH TO DISPLAY
         LR    R4,R7              R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEILEVFK DS    0H
         ASI   VEROFFST,8        BUMP OFFSET
         AHI   R7,8               BUMP FIELD POINTER
         JCT   R2,VEILEVFP        LOOP
*
         ASI   VEROFFST,4+5*8     BUMP OFFSET (MISS PFXMAPOF+STCKS)
VEIFRSPC DS    0H
* PFXFRSPC
         CLI   PFXFRSPC,X'64'     LESS THAN 100 ?
         JL    VEIFRSOK           EXIT IF IT IS
* PFXFRSPC IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,PFXFRSPC        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIFRSOK DS    0H
         ASI   VEROFFST,1         BUMP OFFSET
* PFXFRBLK
* ALL POSITIVE ALGEBRAIC VALUES VALID
         TM    PFXFRBLK,X'80'     VALID ?
         JNO   VEIFBOK            EXIT IF IT IS
* PFXFRBLK IN ERROR
         LA    R9,2               R9=LENGTH TO DISPLAY
         LA    R4,PFXFRBLK        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIFBOK  DS    0H
         ASI   VEROFFST,2         BUMP OFFSET
* PFXFRINT
* ALL POSITIVE ALGEBRAIC VALUES VALID
         TM    PFXFRINT,X'80'     VALID ?
         JNO   VEIFIOK            EXIT IF IT IS
* PFXFRINT IN ERROR
         LA    R9,2               R9=LENGTH TO DISPLAY
         LA    R4,PFXFRINT        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIFIOK  DS    0H
         ASI   VEROFFST,2         BUMP OFFSET
* PFXFFLGS=X'41'
         CLI   PFXFFLGS,PFX_KSDS+PFX_INDX CORRECT FLAGS ?
         JE    VEIFFGOK           EXIT IF THEY ARE
* PFXFFLGS IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,PFXFFLGS        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIFFGOK DS    0H
         ASI   VEROFFST,1         BUMP OFFSET
* PFXRFLGS=X'80'
         CLI   PFXRFLGS,PFX_RFIX  FIXED ?
         JE    VEIRFGOK           EXIT IF NOT
* PFXRFLGS IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,PFXRFLGS        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIRFGOK DS    0H
         ASI   VEROFFST,1         BUMP OFFSET
* PFXAIXN=0 FOR INDEX
         CLI   PFXAIXN,0          AIXN CORRECT ?
         JE    VEIAIXNK           EXIT IF IT IS
* PFXAIXN IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,PFXAIXN         R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIAIXNK DS    0H
         ASI   VEROFFST,1+2       BUMP OFFSET+PADDING
* CTREYE
         CLC   CTREYE,VERCTEYE    EYE=zCTR ?
         JE    VEICTEYK           EXIT IF IT IS
* CTREYE IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,CTREYE          R4=ADDRESS OF INCORRECT VALUE
         LA    R5,VERCTEYE        R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEICTEYK DS    0H
         ASI   VEROFFST,4+4+10*8  BUMP OFFSET
         ASI   VEROFFST,11*8                  (MISS ALL TO CTRLOKEY@)
         CHHSI CTRLOKEY@,-1       LOKEY@=FOXES ?
         JE    VEILOKYK           EXIT IF IT IS
* CTRLOKEY@ IN ERROR
         LA    R9,2               R9=LENGTH TO DISPLAY
         LA    R4,CTRLOKEY@       R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEILOKYK DS    0H
* BFTREYE AND SEQ#
         L     R7,VSAMPRFX        R7=PREFIX BLOCK ADDRESS
         AHI   R7,4096-BFTRLENG   R7=ZVSAMFTR
         USING ZVSAMFTR,R7
         MVHI  VEROFFST,4096-BFTRLENG SET OFFSET
* BFTREYE
         CLC   BFTREYE,CNSTFTR    VERIFY BFTREYE ?
         JE    VEIFEYEK           EXIT IF IT IS
* BFTREYE IN ERROR
         LA    R9,3               R9=LENGTH TO DISPLAY
         LA    R4,BFTREYE         R4=ADDRESS OF INCORRECT VALUE
         LA    R5,CNSTFTR         R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEIFEYEK DS    0H
         ASI   VEROFFST,3         BUMP OFFSET
* BHDRSEQ#=BFTRSEQ#
         CLC   BHDRSEQ#,BFTRSEQ#  SEQ# MATCHES ?
         JE    VEISEQOK           EXIT IF THEY DO
* SEQ# IN ERROR
         LA    R9,1               R9=LENGTH TO DISPLAY
         LA    R4,BHDRSEQ#        R4=ADDRESS OF BHDRSEQ#
         LA    R5,BFTRSEQ#        R5=ADDRESS OF BFTRSEQ#
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VEISEQOK DS    0H
         DROP  R7
* VERIFY BLOCK COUNTS AND CHAINS
         L     R2,PFXBLKSZ        R2=(ADJUSTED) INDEX BLKSIZE
         ST    R2,DTAIN+DCBBLKSIF-IHADCB SAVE BLKSIZE
         ST    R2,DTAIN+DCBLRECLF-IHADCB SAVE LRECL
         GETMAIN RU,LV=(R2)
         ST    R1,VSAMDATA        SAVE VSAM INDEX BLOCK ADDRESS
         LFH   R6,VSAMDATA        R6 HIGH=VSAM INDEX BLOCK ADDRESS
         RLLG  R6,R6,32           SWAP VSAMDATA/VSAMPRFX
* R6 IS NOW VSAMDATA
         MVGHI VERSPCCT,0         CLEAR SPACEMAP BLOCK COUNT
         LGHI  R3,-256            BLOCK NUMBER STARTS AT ZERO
VEIBLOOP DS    0H
         GET   DTAIN,(R6)         GET INDEX BLOCK
* CHECK HDR/FTR SEQ# MATCH
         CLC   BHDREYE,CNSTHDR    VERIFY BHDREYE ?
         JNE   VEIHFSBD           EXIT IF NOT
         LR    R7,R2              R7=INDEX BLKSIZE
         AHI   R7,-BFTRLENG       R7=OFFSET OF FTR
         AR    R7,R6              R7=ADDRESS OF FTR
         CLC   0(3,R7),CNSTFTR    VERIFY BFTREYE ?
         JNE   VEIHFSBD           EXIT IF NOT
         CLC   BHDREYE+3(1),3(R7) SEQ# MATCH ?
         JE    VEIHFSOK           EXIT IF NOT
VEIHFSBD DS    0H
* BAD HDR/FTR/SEQ#
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,8               R9=LENGTH
         LA    R5,BHDRSELF        BASE-FREE
         LA    R8,VERHFSXL        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,4               R9=LENGTH
         LA    R5,BHDREYE         BASE-FREE
         LA    R8,VERHFSHD        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,BFTRLENG        R9=LENGTH
         LA    R8,VERHFSFT        R8=DESTINATION ADDRESS
         TROT  R8,R7,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERHF)    DISPLAY HDR/FTR/SEQ# ERROR
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
VEIHFSOK DS    0H
* COUNT BLOCK TYPES AND VERIFY BHDRSELF
         CLI   BHDRFLG1,BHDR_MAP  IS IT SPACEMAP ?
         JNE   VEINSPAC           EXIT IF NOT
* SPACEMAP BLOCK
         AGSI  VERSPCCT,1         COUNT SPACEMAP BLOCKS
         AGHI  R3,256             BUMP BLOCK NUMBER
* BHDRSELF CHECK
         CG    R3,BHDRSELF        MATCH BHDRSELF ?
         JE    VEIBLOOP           EXIT IF IT DOES
* BHDRSELF IN ERROR
         JAS   R14,VERWTOSF       SHOW BHDRSELF ERROR MESSAGE
         J     VEIBLOOP           LOOP
*
VEINSPAC DS    0H
* INDEX BLOCK
         AGSI  VERIDXCT,1         COUNT INDEX BLOCKS
         AGHI  R3,256             BUMP BLOCK NUMBER
* BHDRXLVL CHECK
         CLI   BHDRXLVL,16        BHDRXLVL LESS THAN 16 ?
         JL    VEIXLVLK           EXIT IF IT IS
* BHDRXLVL IN ERROR
         STG   R3,VERWORK1        SAVE XLRA
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,8               R9=LENGTH
         LA    R5,VERWORK1        BASE-FREE
         LA    R8,VERXLVLX        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,1               R9=LENGTH
         LA    R5,BHDRXLVL        BASE-FREE
         LA    R8,VERXLVL         R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERBX)    DISPLAY BHDRXLVL ERROR
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
         J     VEINOLVL           EXIT
*
VEIXLVLK DS    0H
* BHDRFLG1 CHECK
         CLI   BHDRXLVL,0         LEVEL 0 ?
         JNE   VEINOTL0           EXIT IF NOT
* LEVEL 0 (LEAF BLOCK)
         TM    BHDRFLG1,BHDR_INT  INTERMEDIATE BLOCK ?
         JO    VEIFLGBD           ERROR IF IT IS
         TM    BHDRFLG1,BHDR_LEF  LEAF BLOCK ?
         JNO   VEIFLGBD           ERROR IF NOT
         J     VEILVCNT           EXIT
*
VEINOTL0 DS    0H
         RLLG  R5,R6,32           R5=VSAMPRFX
         CLC   BHDRSELF,BHDRLENG+PFXROOT-ZVSAMPFX(R5) ROOT BLOCK ?
         JNE   VEINOTRT           EXIT IF NOT
* ROOT BLOCK
         TM    BHDRFLG1,BHDR_INT  INTERMEDIATE BLOCK ?
         JO    VEIFLGBD           ERROR IF IT IS
         TM    BHDRFLG1,BHDR_ROT  ROOT BLOCK ?
         JNO   VEIFLGBD           ERROR IF NOT
         J     VEILVCNT           EXIT
*
VEINOTRT DS    0H
* INTERMEDIATE BLOCK
         TM    BHDRFLG1,BHDR_LEF  LEAF BLOCK ?
         JO    VEIFLGBD           ERROR IF IT IS
         TM    BHDRFLG1,BHDR_ROT  ROOT BLOCK ?
         JO    VEIFLGBD           ERROR IF IT IS
         TM    BHDRFLG1,BHDR_INT  INTERMEDIATE BLOCK ?
         JNO   VEIFLGBD           ERROR IF NOT
         J     VEILVCNT           EXIT
*
VEIFLGBD DS    0H
* BHDRFLG1 IN ERROR
         STG   R3,VERWORK1        SAVE XLRA
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,8               R9=LENGTH
         LA    R5,VERWORK1        BASE-FREE
         LA    R8,VERFLGXL        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,1               R9=LENGTH
         LA    R5,BHDRXLVL        BASE-FREE
         LA    R8,VERFLAGX        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,1               R9=LENGTH
         LA    R5,BHDRFLG1        BASE-FREE
         LA    R8,VERFLAGF        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERFG)    DISPLAY BHDRFLG1 ERROR
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
VEILVCNT DS    0H
* COUNT BLOCKS BY LEVEL
         LA    R5,VERIDXLV        BASE-FREE
         LB    R1,BHDRXLVL        R1=BHDRXLVL
         SLL   R1,3               * 8
         AR    R5,R1              R5=INDEXED COUNT
         AGSI  0(R5),1            COUNT BY INDEX LEVEL
VEINOLVL DS    0H
* BHDRSELF CHECK
         CG    R3,BHDRSELF        MATCH BHDRSELF ?
         JE    VEIBLOOP           EXIT IF IT DOES
* BHDRSELF IN ERROR
         JAS   R14,VERWTOSF       SHOW BHDRSELF ERROR MESSAGE
         J     VEIBLOOP           LOOP
*
VEIEOF   DS    0H
* PFXHXLRA CHECK
         RLLG  R6,R6,32           SWAP VSAMDATA/VSAMPRFX
* R6 IS NOW VSAMPRFX
         CG    R3,PFXHXLRA        MATCHES PFXHXLRA ?
         JE    VEIHXLOK           EXIT IF IT DOES
* PFXHXLRA IN ERROR
         STG   R3,VERWORK1        SAVE COUNT
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,8               R9=LENGTH
         LA    R5,PFXHXLRA        BASE-FREE
         LA    R8,VERHXLRA        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,8               R9=LENGTH
         LA    R5,VERWORK1        BASE-FREE
         LA    R8,VERHXCNT        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERHX)    DISPLAY PFXHXLRA ERROR
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
VEIHXLOK DS    0H
* CHASE THE CHAINS AND CHECK THE COUNTS AND TYPES
* INCLUDING LOOP PROTECTION
*
* CHECK BHDR#REC/RPTREND/FREESPACE
*
* SPACEMAP BLOCKS HAVE BIT PATTERN CHECKS
*
* INDEX LEVEL FORWARD SCAN (PFXBLVLn)
         LA    R4,VERLF           R4=TYPE/DIRECTION
         JAS   R14,VERCHAIN       CHECK CHAIN
* INDEX LEVEL BACKWARD SCAN (PFXELVLn)
         LA    R4,VERLB           R4=TYPE/DIRECTION
         JAS   R14,VERCHAIN       CHECK CHAIN
* SPACEMAP FORWARD SCAN
         LA    R4,VERSF           R4=TYPE/DIRECTION
         JAS   R14,VERCHAIN       CHECK CHAIN
* SPACEMAP BACKWARD SCAN
         LA    R4,VERSB           R4=TYPE/DIRECTION
         JAS   R14,VERCHAIN       CHECK CHAIN
VERCLOSE DS    0H
         CLOSE DTAIN              CLOSE INPUT VSAM DCB
* RE-ESTABLISH MAINLINE BASES
         LM    R12,R13,VERBASES   RESTORE MAINLINE BASES R12, R13
         J     PROGEND            EXIT
VERMOVPF MVC   0(0,R2),0(R4)      MOVE PATH\FILE
VERBASES DS    2F                 SAVE MAINLINE BASES R12, R13
*
VERSHOW  DS    0H
* BUILD ERROR LINE AND WTO
* NO LENGTH WILL BE LARGER THAN 8
*
* INPUT: R4=ADDRESS OF INCORRECT VALUE
*        R5=ADDRESS OF CORRECT VALUE, IF ZERO DISPLAYS 'INVALID'
*        R9=LENGTH TO DISPLAY
*
* DESTROYS: R0 R1 R4 R5 R8 R15
         LR    R0,R9              SAVE R9
         MVI   WTOCOREC,C' '      CLEAR WTOCOREC
         MVC   WTOCOREC+1(66),WTOCOREC           AND WTOINCOR
         ARK   R15,R0,R0          R15=LENGTH*2
         AHI   R15,-1             -1 FOR EXECUTE
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LTR   R5,R5              ANY CORRECT VALUE ?
         JNZ   VERDOCOR           EXIT IF THERE IS
         MVC   WTOCOREC(7),VERINVAL MOVE 'INVALID'
         J     VERDOINC           EXIT
*
VERDOCOR DS    0H
         LA    R8,VERTRANS        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         EXRL  R15,VERMVCC        MOVE CORRECT VALUE
VERDOINC DS    0H
         LA    R8,VERTRANS        R8=DESTINATION ADDRESS
         LR    R9,R0              RESTORE LENGTH
         TROT  R8,R4,1            TRANSLATE TO PRINTABLE HEX
         EXRL  R15,VERMVCI        MOVE INCORRECT VALUE
VERSHOWO DS    0H
         LA    R8,VERTRANS        R8=DESTINATION ADDRESS
         LA    R9,4               LENGTH OF OFFSET
         LA    R4,VEROFFST        R4=SOURCE ADDRESS
         TROT  R8,R4,1            TRANSLATE TO PRINTABLE HEX
         LA    R15,8-1            R15=LENGTH OF OFFSET-1 FOR EXECUTE
         EXRL  R15,VERMVCO        MOVE OFFSET
* DISPLAY HEADER LINE
         CLI   WTOVERH1,X'FF'     HAVE WE DONE IT ?
         JE    VERHDRDK           EXIT IF WE HAVE
         WTO   MF=(E,WTOVERH1)    DISPLAY DATA HEADER LINE
         MVI   WTOVERH1,X'FF'     MARK HEADER DONE
         J     VERHDRIK           EXIT
VERMVCC  MVC   WTOCOREC(0),VERTRANS MOVE CORRECT VALUE
VERMVCI  MVC   WTOINCOR(0),VERTRANS MOVE INCORRECT VALUE
VERMVCO  MVC   WTOOFFST(0),VERTRANS MOVE OFFSET
*
VERHDRDK DS    0H
         CLI   WTOVERH2,X'FF'     HAVE WE DONE IT ?
         JE    VERHDRIK           EXIT IF WE HAVE
         WTO   MF=(E,WTOVERH2)    DISPLAY INDEX HEADER LINE
         MVI   WTOVERH2,X'FF'     MARK HEADER DONE
VERHDRIK DS    0H
* DISPLAY ERROR LINE
         WTO   MF=(E,WTOVEROR)    DISPLAY ERROR LINE
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         BNER  R14                RETURN IF NOT
VERABORT DS    0H
* DISPLAY ERROR LIMIT REACHED
         WTO   MF=(E,WTOVERLM)    DISPLAY ERROR LIMIT REACHED
         J     VERCLOSE           END PROGRAM
*
VERWTOSF DS    0H
* BHDRSELF IN ERROR, DISPLAY ERROR MESSAGE
*
* DESTROYS: R1 R5 R8 R9 R10
         STG   R3,VERWORK1        SAVE XLRA
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,8               R9=LENGTH
         LA    R5,BHDRSELF        BASE-FREE
         LA    R8,VERSELF         R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,8               R9=LENGTH
         LA    R5,VERWORK1        BASE-FREE
         LA    R8,VERSFBLK        R8=DESTINATION ADDRESS
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERSF)    DISPLAY BHDRSELF ERROR
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
         BR    R14                RETURN
*
VERCHAIN DS    0H
* CHASE THE CHAINS AND CHECK THE COUNTS AND TYPES
* INCLUDING LOOP PROTECTION
*
* VIA SUBROUTINE VERRPFS CHECK BHDR#REC/RPTREND/FREESPACE FOR DATA,
* INDEX AND SEGMENT BLOCKS
*
* SPACEMAP BLOCKS HAVE BIT PATTERN CHECKS
*
* INPUT: R4  POINTS TO 2-LETTER TYPE/DIRECTION CODE
*        R6 LOW =VSAMPRFX
*        R6 HIGH=VSAMDATA
*
* DESTROYS: R0-R3 R5 R7-R9 R10 HIGH
         ST    R14,VERCHN14       SAVE RETURN ADDRESS
         RLLG  R14,R6,32          R14=VSAMDATA (DATA/INDEX BLOCK)
DATABHDR USING ZVSAMHDR,R14       BASE OF DATA/INDEX BLOCK
         IIHF  R10,VERLIMIT       R10 HIGH=CHAIN LOOP LIMIT
* LOAD ANCHOR POINT
         LG    R2,PFXBDATA        R2=XLRA OF DATA/INDEX FORWARD CHAIN
         CHHSI 0(R4),C'DF'        IS IT DATA FORWARD ?
         JE    VERCHND1           EXIT IF IT IS
         LG    R2,PFXEDATA        R2=XLRA OF DATA/INDEX BACKWARD CHAIN
         CHHSI 0(R4),C'DB'        IS IT DATA BACKWARD ?
         JE    VERCHND1           EXIT IF IT IS
         LG    R2,PFXBSEGM        R2=XLRA OF SEGMENT FORWARD CHAIN
         CHHSI 0(R4),C'GF'        IS IT SEGMENT FORWARD ?
         JE    VERCHND1           EXIT IF IT IS
         LG    R2,PFXESEGM        R2=XLRA OF SEGMENT BACKWARD CHAIN
         CHHSI 0(R4),C'GB'        IS IT SEGMENT BACKWARD ?
         JE    VERCHND1           EXIT IF IT IS
         LG    R2,PFXBMAP         R2=XLRA OF SPACEMAP FORWARD CHAIN
         CHHSI 0(R4),C'SF'        IS IT SPACEMAP FORWARD ?
         JE    VERCHND1           EXIT IF IT IS
         LG    R2,PFXEMAP         R2=XLRA OF SPACEMAP BACKWARD CHAIN
         CHHSI 0(R4),C'SB'        IS IT SPACEMAP BACKWARD ?
         JE    VERCHND1           EXIT IF IT IS
VERLVLLP DS    0H
* MUST BE INDEX LEVEL
         L     R7,VERLEVEL        R7=CURRENT LEVEL
         SLL   R7,4               * 16
         LA    R7,PFXBLVL0(R7)    R7=INDEX LEVEL PAIR
         CGHSI 0(R7),-1           ANY LEVEL CHAIN HERE ?
         JE    VERLVLDN           EXIT IF NONE
* GOT AN INDEX LEVEL PAIR
         CLI   1(R4),C'F'         FORWARDS ?
         JE    VERLVLFW           EXIT IF IT IS
         AHI   R7,8               R7=INDEX LEVEL BACKWARDS
VERLVLFW DS    0H
         LG    R2,0(R7)           R2=XLRA OF LEVEL CHAIN
VERCHND1 DS    0H
         MVGHI VERBITCT,0         CLEAR SPACEMAP BIT COUNT
         SGR   R7,R7              CLEAR R7
VERCHNLP DS    0H
* LOOP THROUGH BLOCKS
         SRLG  R2,R2,8            SHIFT OUT RECORD NUMBER
         MSGF  R2,PFXBLKSZ        * (ADJUSTED) DATA BLKSIZE
         ALGFI R2,4096            + PREFIX SIZE
         STG   R2,VERWORK1        SAVE IT
         POINT DTAIN,RBA=VERWORK1 POINT TO BLOCK
         GET   DTAIN,(R14)        GET DATA/INDEX BLOCK
         AGHI  R7,1               COUNT THEM
         AIH   R10,-1             -1
         JNZ   VERCHNOK           EXIT IF NO LOOP DETECTED SO FAR
*###DUMP BRCTH R10,VERCHNOK       EXIT IF NO LOOP DETECTED SO FAR
*
* LOOP DETECTED
* WTO AND ABORT FURTHER CHAIN TESTS
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
         LA    R5,CONDATA         R5=CONDATA
         CLI   0(R4),C'D'         IS IT DATA ?
         JE    VERCHNT1           EXIT IF IT IS
         LA    R5,CONLEVEL        R5=CONLEVEL
         CLI   0(R4),C'L'         IS IT INDEX LEVEL ?
         JE    VERCHNT1           EXIT IF IT IS
         LA    R5,CONSEGM         R5=CONSEGM
         CLI   0(R4),C'G'         IS IT SEGMENT ?
         JE    VERCHNT1           EXIT IF IT IS
         LA    R5,CONSPACE        R5=CONSPACE
VERCHNT1 DS    0H
         MVC   VERTYPE,0(R5)      MOVE TYPE
         LA    R5,CONFWD          R5=CONFWD
         CLI   1(R4),C'F'         IS IT FORWARD ?
         JE    VERCHND2           EXIT IF IT IS
         LA    R5,CONBWD          R5=CONBWD
VERCHND2 DS    0H
         MVC   VERDIR,0(R5)       MOVE DIRECTION
         WTO   MF=(E,WTOVERLP)    DISPLAY LOOP DETECTED
VERCHNCY DS    0H
* DISPLAY 8 XLRA'S IN LOOP IN TWO GROUPS OF 4
         SGR   R0,R0              CLEAR R0
         LA    R8,VERXLRA         R8=VERXLRA
         AHHLR R3,R0,R8           R3 HIGH=POSITION CONTROL
         LA    R5,4               R5=LOOP LIMIT
VERCHNBD DS    0H
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,8               R9=LENGTH
         CLI   1(R4),C'F'         IS IT FORWARD ?
         JNE   VERCHND3           EXIT IF NOT
         LA    R2,DATABHDR.BHDRNEXT R2=NEXT XLRA IN LOOP
         J     VERCHNX1           EXIT
*
VERCHND3 DS    0H
         LA    R2,DATABHDR.BHDRPREV R2=PREV XLRA IN LOOP
VERCHNX1 DS    0H
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         LG    R2,DATABHDR.BHDRNEXT R2=NEXT XLRA
         CLI   1(R4),C'F'         IS IT FORWARD ?
         JE    VERCHND4           EXIT IF IT IS
         LG    R2,DATABHDR.BHDRPREV R2=PREV XLRA
VERCHND4 DS    0H
         SRLG  R2,R2,8            SHIFT OUT RECORD NUMBER
         MSGF  R2,PFXBLKSZ        * (ADJUSTED) DATA BLKSIZE
         ALGFI R2,4096            + PREFIX SIZE
         STG   R2,VERWORK1        SAVE IT
         POINT DTAIN,RBA=VERWORK1 POINT TO BLOCK
         GET   DTAIN,(R14)        GET DATA/INDEX BLOCK
         AIH   R3,17              BUMP XLRA POINTER
         LGR   R8,R3              R8=DESTINATION
         SRLG  R8,R8,32           SHIFT TO LOW
         JCT   R5,VERCHNBD        LOOP
*
         WTO   MF=(E,WTOVERXL)    DISPLAY 4 XLRA'S
         CLI   VERTYPE,X'FF'      2ND 4 DONE ?
         JE    VERRETRN           RETURN IF WE HAVE
         MVI   VERTYPE,X'FF'      MARK 1ST 4 DONE
         J     VERCHNCY           LOOP
*
VERCHNOK DS    0H
* CHECK BLOCK TYPE IS CORRECT FOR CHAIN
         CLI   0(R4),C'D'         IS IT DATA ?
         JNE   VERCHNT4           EXIT IF NOT
* DATA BLOCK
         TM    DATABHDR.BHDRFLG1,BHDR_DTA IS IT DATA ?
         JNO   VERCHNWC           ERROR IF NOT
* DATA BLOCK
         JAS   R14,VERRPFS        CHECK BHDR#REC/RPTREND/FREESPACE
         RLLG  R14,R6,32          R14=VSAMDATA (DATA/INDEX BLOCK)
* IF NON-UNIQUE AIX...
*    IF FIRST SEGMENT, GET THE ELIX BLOCK, CHECK IT IS
*    CHECK BHDRPREV POINTS BACK TO THE DATA BLOCK
*    FOR EACH ELIX ENTRY...
*       COUNT=2, THEN CHECK ENTRY 1=FIRST, ENTRY 2=LAST
*       COUNT=N, THEN CHECK ENTRY 1=FIRST, ENTRIES 2 TO N-1=MIDDLE
*                           ENTRY N=LAST
         CLI   DATABHDR.BHDR#REC,1 1 RECORD ?
         JNE   VERCHNTK           EXIT IF NOT
         LA    R2,DATABHDR.BHDRLENG(R14) R2=RPTR ADDRESS
         USING ZVSAMRPT,R2
         TM    PFXFFLGS,PFX_AIX   IS IT AN AIX ?
         JNO   VERCHNTK           EXIT IF NOT
* AIX
         TM    RPTRFLGS,RPTR_SEG  IS IT A FIRST SEGMENT ?
         JNO   VERCHNTK           EXIT IF NOT
* AIX AND DATA BLOCK IS A FIRST SEGMENT
* GET THE ELIX BLOCK
         LG    R1,RPTRLENG*2(R2)  R1=ELIX XLRA
         SRLG  R1,R1,8            SHIFT OUT RECORD NUMBER
         MSGF  R1,PFXBLKSZ        * (ADJUSTED) DATA BLKSIZE
         ALGFI R1,4096            + PREFIX SIZE
         STG   R1,VERWORK1        SAVE RBA OF ELIX BLOCK
         L     R8,VSAMELIX        R8=ELIX BLOCK AREA
         POINT DTAIN,RBA=VERWORK1 POINT TO ELIX BLOCK
         GET   DTAIN,(R8)         GET ELIX BLOCK
         TM    BHDRFLG2-ZVSAMHDR(R8),BHDR_ELX IS IT AN ELIX BLOCK ?
         JNO   VERELXB1           ERROR IF NOT
* ELIX XLRA DOES POINT TO AN ELIX BLOCK
         LG    R1,BHDRPREV-ZVSAMHDR(R8) R1=ELIX BHDRPREV
         CG    R1,DATABHDR.BHDRSELF ELIX PREV=DATA SELF ?
         JNE   VERELXB2           ERROR IF NOT
* ELIX BHDRPREV=DATA BHDRSELF
*
* CHECK THAT EACH ELIX ENTRY POINTS TO CORRECT TYPE OF BLOCK
         L     R5,BHDRLENG(R8)    R5=ELIX ENTRY COUNT
         LA    R9,1               R9=ELIX ENTRY COUNT TRACKER
         SGR   R0,R0              CLEAR R0
         AHHLR R3,R0,R8           R3 HIGH=ELIX
         AIH   R3,BHDRLENG+4                   ENTRY POINTER
         L     R1,AIXNBSXL        R1=ELEMENT LENGTH
         AHHLR R3,R3,R1           R3 HIGH=ELIX XLRA POINTER
VERELXLP DS    0H
         LGR   R1,R3              R1 HIGH=ELIX XLRA POINTER
         SRLG  R1,R1,32           SHIFT TO LOW
         LG    R1,0(R1)           R1=ELIX XLRA
         SRLG  R1,R1,8            SHIFT OUT RECORD NUMBER
         MSGF  R1,PFXBLKSZ        * (ADJUSTED) DATA BLKSIZE
         ALGFI R1,4096            + PREFIX SIZE
         STG   R1,VERWORK1        SAVE RBA OF ELIX BLOCK
         POINT DTAIN,RBA=VERWORK1 POINT TO SEGMENT BLOCK
         L     R0,VSAMSEGM        R0=SEGMENT BLOCK ADDRESS
         GET   DTAIN,(R0)         GET SEGMENT BLOCK
         AHIK  R2,R0,BHDRLENG     R2=FIRST RPTR
         L     R2,RPTRREC@        R2=SEGMENT OFFSET
         DROP  R2
         ARK   R1,R2,R0           R1=SEGMENT ADDRESS
         USING ZVSAMSPX,R1
* ELIX COUNT TRACKER DETERMINES WHAT KIND OF SEGMENT IT IS
         CFI   R9,1               FIRST SEGMENT EXPECTED ?
         JNE   VERELXNF           EXIT IF NOT
         TM    SPXSEGCC,SPXSFRST  IS IT A FIRST SEGMENT ?
         JNO   VERELXB3           ERROR IF NOT
         J     VERELXIN           EXIT
*
VERELXNF DS    0H
         C     R9,BHDRLENG(R8)    LAST SEGMENT EXPECTED ?
         JNE   VERELXNL           EXIT IF NOT
         TM    SPXSEGCC,SPXSLAST  IS IT A LAST SEGMENT ?
         JNO   VERELXB3           ERROR IF NOT
         J     VERELXIN           EXIT
*
VERELXNL DS    0H
* MUST BE A MIDDLE
         TM    SPXSEGCC,SPXSMIDL  IS IT A MIDDLE SEGMENT ?
         JNO   VERELXB3           ERROR IF NOT
VERELXIN DS    0H
         AHI   R9,1               BUMP ELIX COUNT TRACKER
         L     R1,AIXNBSXL        R1=ELEMENT LENGTH
         AHHLR R3,R3,R1           R3 HIGH=NEXT ELIX
         AIH   R3,8                                 XLRA POINTER
         JCT   R5,VERELXLP        LOOP
*
         J     VERCHNTK           EXIT
*
VERELXB1 DS    0H
* FIRST SEGMENT DOES NOT POINT TO ELIX BLOCK
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,8               R9=LENGTH
         MVC   VERWORK1(8),DATABHDR.BHDRSELF SAVE DATA XLRA
         LA    R8,VERFST1         BASE-FREE
         LA    R5,VERWORK1        R5=VERWORK1
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,8               R9=LENGTH
         LG    R8,RPTRLENG*2(R2)  R8=ELIX XLRA
         STG   R8,VERWORK1        SAVE ELIX XLRA
         LA    R8,VERELIX         BASE-FREE
         LA    R5,VERWORK1        R5=VERWORK1
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERNX)    DISPLAY 1ST SEG NOT POINTING TO ELIX
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
         J     VERCHNTK           EXIT
*
VERELXB2 DS    0H
* ELIX BHDRPREV NOT EQUAL TO DATA BHDRSELF
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,8               R9=LENGTH
         MVC   VERWORK1(8),DATABHDR.BHDRSELF SAVE DATA XLRA
         LA    R8,VERFST2         BASE-FREE
         LA    R5,VERWORK1        R5=VERWORK1
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R5,VERWORK1        R5=VERWORK1
         LA    R9,8               R9=LENGTH
         LG    R8,RPTRLENG*2(R2)  R8=ELIX XLRA
         STG   R8,VERWORK1        SAVE ELIX BHDRPREV
         LA    R8,VERELXPV        BASE-FREE
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERPV)    DISPLAY 1ST SEG NE TO ELIX PREV
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
         J     VERCHNTK           EXIT
*
VERELXB3 DS    0H
* ELIX XLRA NOT POINTING TO CORRECT SEGMENT TYPE
         LR    R15,R9             SAVE R9
         LA    R9,1               R9=LENGTH
         MVC   VERWORK1(1),SPXSEGCC SAVE SPXSEGCC
         DROP  R1
         LR    R0,R8              SAVE R8
         LA    R8,VERELXSX        BASE-FREE
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R5,VERWORK1        R5=VERWORK1
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,8               R9=LENGTH
         LR    R8,R0              RESTORE R8
         MVC   VERWORK1(8),BHDRSELF-ZVSAMHDR(R8) SAVE ELIX BHDRSELF
         LA    R8,VERELIX@        BASE-FREE
         LA    R5,VERWORK1        R5=VERWORK1
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,8               R9=LENGTH
         LGR   R8,R3              R8 HIGH=ELIX XLRA POINTER
         SRLG  R8,R8,32           SHIFT TO LOW
         MVC   VERWORK1(8),0(R8)  SAVE ELIX ELEMENT XLRA
         LA    R8,VERELIXX        BASE-FREE
         LA    R5,VERWORK1        R5=VERWORK1
         TROT  R8,R5,1            TRANSLATE TO PRINTABLE HEX
         LR    R9,R15             RESTORE R9
         LR    R8,R0              RESTORE R8
         WTO   MF=(E,WTOVERX1)    DISPLAY HEADER LINE
         WTO   MF=(E,WTOVERX2)    DISPLAY DATA LINE
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
         J     VERELXIN           EXIT
*
VERCHNT4 DS    0H
         CLI   0(R4),C'L'         IS IT INDEX LEVEL ?
         JNE   VERCHNT2           EXIT IF NOT
* INDEX LEVEL BLOCK
         TM    DATABHDR.BHDRFLG1,BHDR_IDX IS IT INDEX ?
         JNO   VERCHNWC           ERROR IF NOT
         JAS   R14,VERRPFS        CHECK BHDR#REC/RPTREND/FREESPACE
         RLLG  R14,R6,32          R14=VSAMDATA (DATA/INDEX BLOCK)
         J     VERCHNTK           EXIT
*
VERCHNT2 DS    0H
         CLI   0(R4),C'G'         IS IT SEGMENT ?
         JNE   VERCHNT3           EXIT IF NOT
* SEGMENT BLOCK
         TM    DATABHDR.BHDRFLG1,BHDR_DTA+BHDR_SEG IS IT SEGMENT ?
         JNO   VERCHNWC           ERROR IF NOT
         JAS   R14,VERRPFS        CHECK BHDR#REC/RPTREND/FREESPACE
         RLLG  R14,R6,32          R14=VSAMDATA (DATA/INDEX BLOCK)
         J     VERCHNTK           EXIT
*
VERCHNT3 DS    0H
* SPACEMAP BLOCK
         CLI   DATABHDR.BHDRFLG1,BHDR_MAP IS IT SPACEMAP ?
         JNE   VERCHNWC           EXIT IF NOT
* COUNT BIT PATTERNS AND MATCH AGAINST TOTAL RECORDS
         AHIK  R5,R14,BHDRLENG+L'MAPXLRA R5=ADDRESS OF MAPBITS
         L     R8,PFXBLKSZ        R8=END OF
         AR    R8,R14                       BLOCK ADDRESS
         AHI   R8,-BFTRLENG       R8=ADDRESS OF LAST SPACEMAP BYTE
VERBYTLP DS    0H
         SR    R1,R1              CLEAR R1
         LA    R2,4               R2=LOOP COUNT
         ICM   R1,B'1000',0(R5)   R1=MAPBITS BYTE
VERBITLP DS    0H
         SR    R0,R0              CLEAR R0
         SLDL  R0,2               PAIR OF BITS INTO R0
         LTR   R0,R0              ZERO ?
         JZ    VERBIT00           EXIT IF IT IS
         AGSI  VERBITCT,1         COUNT BLOCKS
         JCT   R2,VERBITLP        LOOP THROUGH 4 PAIRS OF BITS
*
         AHI   R5,1               BUMP BYTE POINTER
         CR    R5,R8              END OF SPACEMAP BLOCK ?
         JNH   VERBYTLP           LOOP IF NOT
         J     VERCHNTK           EXIT
*
VERBIT00 DS    0H
* PFXMAPOF CAN ONLY BE DERIVED FROM PFXEMAP
* IF R2=4, THE 1ST TWO BITS ARE 00 AND THE LAST USED IS PREVIOUS BYTE
         CLC   DATABHDR.BHDRSELF,PFXEMAP LAST SPACEMAP BLOCK ?
         JNE   VERBITNL           EXIT IF NOT
* LAST SPACEMAP BLOCK
         CHI   R2,4               1ST TWO BITS ZERO ?
         JNE   VERBITPV           EXIT IF NOT
         AHI   R5,-1              BACK OFF TO PREVIOUS BYTE
VERBITPV DS    0H
         ST    R5,VERWORK2        SAVE ADDR OF LAST USED SPACEMAP BYTE
VERBITNL DS    0H
         LG    R2,DATABHDR.BHDRNEXT R2=NEXT XLRA
         CLI   1(R4),C'F'         IS IT FORWARD ?
         JE    VERBITFW           EXIT IF IT IS
         LG    R2,DATABHDR.BHDRPREV R2=PREV XLRA
VERBITFW DS    0H
         CGHI  R2,-1              ANY NEXT/PREVIOUS BLOCK ?
         JNE   VERCHNLP           LOOP IF THERE IS
*
* LAST SPACEMAP BLOCK PROCESSED
* FOR DATA,  ADD DATA+SEGMENT+SPACEMAP BLOCKS
* FOR INDEX, ADD ALL LEVEL BLOCKS+SPACEMAP BLOCKS
         TM    PFXFFLGS,PFX_INDX  INDEX ?
         JNO   VERDTABK           EXIT IF NOT
* SUM INDEX BLOCKS
         SGR   R2,R2              CLEAR R2
         LA    R1,16              R1=LOOP COUNT
         LA    R9,VERIDXLV        R9=VERIDXLV
VERIDXBK DS    0H
         AG    R2,0(R9)           SUM INDEX LEVEL COUNTS
         AHI   R9,8               BUMP POINTER
         JCT   R1,VERIDXBK        LOOP
*
         AG    R2,VERSPCCT        +SPACEMAP BLOCKS
         J     VERBITCK           EXIT
*
VERDTABK DS    0H
* SUM DATA BLOCKS
         LG    R2,VERDTACT        R2=DATA BLOCKS
         AG    R2,VERELXCT        +ELIX BLOCKS
         AG    R2,VERSEGCT        +SEGMENT BLOCKS
         AG    R2,VERSPCCT        +SPACEMAP BLOCKS
VERBITCK DS    0H
         CG    R2,VERBITCT        MATCH TO BIT COUNT ?
         JE    VERBITDN           EXIT IF IT DOES
* BIT COUNT IN ERROR
* DISPLAY BLOCK COUNT DIFFERENCE
         LA    R8,CONFWD          R8=CONFWD
         CLI   1(R4),C'F'         IS IT FORWARD ?
         JE    VERBITD1           EXIT IF IT IS
         LA    R8,CONBWD          R8=CONBWD
VERBITD1 DS    0H
         MVC   VERBITDR,0(R8)     MOVE DIRECTION
         LG    R1,VERBITCT        R1=BIT PATTERN COUNT
         CVDG  R1,VERWORK1        CONVERT BIT PATTERN COUNT TO DECIMAL
         MVC   VERBITPT,VEREDIT   MOVE EDIT WORD
         ED    VERBITPT,VERWORK1+10 EDIT BIT PATTERN COUNT
         CVDG  R2,VERWORK1        CONVERT BLOCK COUNT TO DECIMAL
         MVC   VERBITBK,VEREDIT   MOVE EDIT WORD
         ED    VERBITBK,VERWORK1+10 EDIT BLOCK COUNT
         WTO   MF=(E,WTOVERBT)    DISPLAY SPACEMAP BITS NE BLOCK COUNT
         WTO   MF=(E,WTOVERB1)    DISPLAY BIT PATTERN/BLOCK COUNTS
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
VERBITDN DS    0H
         L     R5,VERWORK2        LAST BYTE USED IN LAST SPACEMAP BLOCK
         SR    R5,R14             R5=OFFSET OF LAST USED SPACEMAP BYTE
         C     R5,PFXMAPOF        OFFSETS MATCH ?
         JE    VERCHNC2           EXIT IF THEY DO
* DISPLAY PFXMAPOF MISMATCH
         LA    R8,CONFWD          R8=CONFWD
         CLI   1(R4),C'F'         IS IT FORWARD ?
         JE    VERPFXD1           EXIT IF IT IS
         LA    R8,CONBWD          R8=CONBWD
VERPFXD1 DS    0H
         MVC   VERPFXDR,0(R8)     MOVE DIRECTION
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,4               R9=LENGTH
         LA    R2,PFXMAPOF        BASE-FREE
         LA    R8,VERPFXMF        R8=DESTINATION ADDRESS
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,4               R9=LENGTH
         LA    R2,VERWORK1        BASE-FREE
         ST    R5,VERWORK1        SAVE CALCULATED PFXMAPOF
         LA    R8,VERPFXCC        R8=DESTINATION ADDRESS
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVEROF)    DISPLAY SPACEMAP PFXMAPOF MISMATCH
         WTO   MF=(E,WTOVERO1)    DISPLAY PFXMAPOF/CALCULATED
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
         J     VERCHNC2           EXIT
*
VERCHNWC DS    0H
* DISPLAY BLOCK ON WRONG CHAIN
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,8               R9=LENGTH
         LA    R2,DATABHDR.BHDRSELF R2=XLRA
         LA    R8,VERXLRAW        BASE-FREE
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         LA    R5,CONDATA         R5=CONDATA
         CLI   0(R4),C'D'         IS IT DATA ?
         JE    VERCHNW1           EXIT IF IT IS
         LA    R5,CONLEVEL        R5=CONLEVEL
         CLI   0(R4),C'L'         IS IT INDEX LEVEL ?
         JE    VERCHNW1           EXIT IF IT IS
         LA    R5,CONSEGM         R5=CONSEGM
         CLI   0(R4),C'G'         IS IT SEGMENT ?
         JE    VERCHNW1           EXIT IF IT IS
         LA    R5,CONSPACE        R5=CONSPACE
VERCHNW1 DS    0H
         MVC   VERTYPEW,0(R5)     MOVE TYPE
         LA    R9,1               R9=LENGTH
         LA    R2,DATABHDR.BHDRFLG1 R2=BHDRFLG1
         LA    R8,VERFLGSW        BASE-FREE
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERWC)    DISPLAY BLOCK ON WRONG CHAIN
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
VERCHNTK DS    0H
         LG    R2,DATABHDR.BHDRNEXT R2=NEXT XLRA
         CLI   1(R4),C'F'         IS IT FORWARD ?
         JE    VERCHND5           EXIT IF IT IS
         LG    R2,DATABHDR.BHDRPREV R2=PREV XLRA
VERCHND5 DS    0H
         CGHI  R2,-1              ANY NEXT/PREVIOUS BLOCK ?
         JNE   VERCHNLP           LOOP IF THERE IS
* CHECK SEQUENTIAL COUNT VS ANCHOR COUNT
         CLI   0(R4),C'D'         IS IT DATA ?
         JNE   VERCHNC4           EXIT IF NOT
* DATA BLOCK
         CG    R7,VERDTACT        CORRECT NUMBER ?
         JE    VERRETRN           RETURN IF IT IS
* DATA CHAINING CAUSED COUNT DIFFERENCE
         MVC   VERTYPC2,CONDATA   MOVE TYPE
         CVDG  R7,VERWORK1        CONVERT TO DECIMAL
         MVC   VERANCCT,VEREDIT   MOVE EDIT WORD
         ED    VERANCCT,VERWORK1+10 EDIT ANCHOR COUNT
         LG    R7,VERDTACT        R7=DATA BLOCK COUNT
         CVDG  R7,VERWORK1        CONVERT TO DECIMAL
         MVC   VERSEQCT,VEREDIT   MOVE EDIT WORD
         ED    VERSEQCT,VERWORK1+10 EDIT SEQUENTIAL COUNT
         J     VERCTWTO           EXIT
*
VERCHNC4 DS    0H
         CLI   0(R4),C'L'         IS IT INDEX LEVEL ?
         JNE   VERCHNC1           EXIT IF NOT
* INDEX LEVEL BLOCK
         L     R8,VERLEVEL        R8=INDEX LEVEL
         CVD   R8,VERWORK1        CONVERT INDEX LEVEL TO DECIMAL
         MVC   VERWORK2(4),VEREDLVL MOVE EDIT WORD
         ED    VERWORK2(4),VERWORK1+5 EDIT INDEX LEVEL
         MVC   CONLEVEL+6(2),VERWORK2+2 MOVE INDEX LEVEL INTO CONSTANT
         SLL   R8,3               INDEX LEVEL * 8
         LA    R5,VERIDXLV        R5=INDEX LEVEL COUNTS
         AR    R5,R8              R5=INDEX LEVEL COUNT POINTER
         MVC   VERWORK2,0(R5)     SAVE INDEX LEVEL COUNT
         CG    R7,0(R5)           CORRECT NUMBER ?
         JE    VERLVLOK           EXIT IF IT IS
* INDEX LEVEL CHAINING CAUSED COUNT DIFFERENCE
         MVC   VERTYPC2,CONLEVEL  MOVE TYPE
         CVDG  R7,VERWORK1        CONVERT TO DECIMAL
         MVC   VERANCCT,VEREDIT   MOVE EDIT WORD
         ED    VERANCCT,VERWORK1+10 EDIT ANCHOR COUNT
         LG    R7,VERWORK2        R7=INDEX LEVEL BLOCK COUNT
         CVDG  R7,VERWORK1        CONVERT TO DECIMAL
         MVC   VERSEQCT,VEREDIT   MOVE EDIT WORD
         ED    VERSEQCT,VERWORK1+10 EDIT SEQUENTIAL COUNT
         J     VERCTWTO           EXIT
*
VERCHNC1 DS    0H
         CLI   0(R4),C'G'         IS IT SEGMENT ?
         JNE   VERCHNC2           EXIT IF NOT
* SEGMENT BLOCK
         CG    R7,VERSEGCT        CORRECT NUMBER ?
         JE    VERRETRN           RETURN IF IT IS
* SEGMENT CHAINING CAUSED COUNT DIFFERENCE
         MVC   VERTYPC2,CONSEGM   MOVE TYPE
         CVDG  R7,VERWORK1        CONVERT TO DECIMAL
         MVC   VERANCCT,VEREDIT   MOVE EDIT WORD
         ED    VERANCCT,VERWORK1+10 EDIT ANCHOR COUNT
         LG    R7,VERSEGCT        R7=SEGMENT BLOCK COUNT
         CVDG  R7,VERWORK1        CONVERT TO DECIMAL
         MVC   VERSEQCT,VEREDIT   MOVE EDIT WORD
         ED    VERSEQCT,VERWORK1+10 EDIT SEQUENTIAL COUNT
         J     VERCTWTO           EXIT
*
VERCHNC2 DS    0H
* SPACEMAP BLOCK
         CG    R7,VERSPCCT        CORRECT NUMBER ?
         JE    VERRETRN           RETURN IF IT IS
* SPACEMAP CHAINING CAUSED COUNT DIFFERENCE
         MVC   VERTYPC2,CONSPACE  MOVE TYPE
         CVDG  R7,VERWORK1        CONVERT TO DECIMAL
         MVC   VERANCCT,VEREDIT   MOVE EDIT WORD
         ED    VERANCCT,VERWORK1+10 EDIT ANCHOR COUNT
         LG    R7,VERSPCCT        R7=SPACEMAP BLOCK COUNT
         CVDG  R7,VERWORK1        CONVERT TO DECIMAL
         MVC   VERSEQCT,VEREDIT   MOVE EDIT WORD
         ED    VERSEQCT,VERWORK1+10 EDIT SEQUENTIAL COUNT
VERCTWTO DS    0H
* DISPLAY COUNT DIFFERENCE MESSAGES
         LA    R5,CONFWD          R5=CONFWD
         CLI   1(R4),C'F'         IS IT FORWARD ?
         JE    VERCHNC3           EXIT IF IT IS
         LA    R5,CONBWD          R5=CONBWD
VERCHNC3 DS    0H
         MVC   VERDIRC2,0(R5)     MOVE DIRECTION
         WTO   MF=(E,WTOVERC1)    DISPLAY HEADER
         WTO   MF=(E,WTOVERC2)    DISPLAY TYPE/DIRECTION
         WTO   MF=(E,WTOVERC3)    DISPLAY SEQUENTIAL COUNT
         WTO   MF=(E,WTOVERC4)    DISPLAY ANCHOR COUNT
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
VERLVLOK DS    0H
         CLI   0(R4),C'L'         IS IT INDEX LEVEL ?
         JNE   VERRETRN           RETURN IF NOT
         ASI   VERLEVEL,1         BUMP INDEX LEVEL
         CHSI  VERLEVEL,16        DONE THEM ALL ?
         JNE   VERLVLLP           LOOP IF NOT
VERLVLDN DS    0H
* END OF INDEX LEVELS
* CHECK THAT THE SUM OF LEVEL BLOCKS=NO. OF INDEX BLOCKS
         SGR   R1,R1              CLEAR R1
         LA    R8,VERIDXLV        R8=INDEX LEVEL COUNTS
         LA    R9,16              R9=LEVEL COUNT
VERLVLCK DS    0H
         AG    R1,0(R8)           SUM LEVEL COUNTS
         AHI   R8,8               BUMP LEVEL COUNT
         JCT   R9,VERLVLCK        LOOP
*
         CG    R1,VERIDXCT        CORRECT NUMBER ?
         JE    VERLVLRT           EXIT IF IT IS
* INDEX CHAINING CAUSED COUNT DIFFERENCE
         MVC   VERTYPC2,CONINDEX  MOVE TYPE
         CVDG  R1,VERWORK1        CONVERT TO DECIMAL
         MVC   VERANCCT,VEREDIT   MOVE EDIT WORD
         ED    VERANCCT,VERWORK1+10 EDIT ANCHOR COUNT
         LG    R7,VERIDXCT        R7=INDEX BLOCK COUNT
         CVDG  R7,VERWORK1        CONVERT TO DECIMAL
         MVC   VERSEQCT,VEREDIT   MOVE EDIT WORD
         ED    VERSEQCT,VERWORK1+10 EDIT SEQUENTIAL COUNT
         MVI   0(R4),C'X'         ENSURE WE DON'T LOOP
         J     VERCTWTO           EXIT
*
VERLVLRT DS    0H
* CHECK LAST INDEX LEVEL PROCESSED PFXROOT=PFXBLVLn=PFXELVLn
         AHI   R7,-16             BACK OFF TO LAST USED PAIR
         CLC   PFXROOT,0(R7)      PFXROOT=PFXBLVLn ?
         JNE   VERRTBAD           EXIT IF NOT
         CLC   PFXROOT,8(R7)      PFXROOT=PFXELVLn ?
         JE    VERRETRN           RETURN IF IT IS
VERRTBAD DS    0H
* PFXROOT MISMATCH
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,8               R9=LENGTH
         LA    R2,PFXROOT         R2=PFXROOT
         LA    R8,VERPFXRT        BASE-FREE
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,8               R9=LENGTH
         LR    R2,R7              R2=PFXBLVLn
         LA    R8,VERBLVL         BASE-FREE
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,8               R9=LENGTH
         LA    R2,8(R7)           R2=PFXELVLn
         LA    R8,VERELVL         BASE-FREE
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERP1)    DISPLAY HEADER
         WTO   MF=(E,WTOVERP2)    DISPLAY PFXROOT
         WTO   MF=(E,WTOVERP3)    DISPLAY PFXBLVLn
         WTO   MF=(E,WTOVERP4)    DISPLAY PFXELVLn
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
VERRETRN DS    0H
         L     R14,VERCHN14       RESTORE R14
         BR    R14                RETURN
VERCHN14 DS    F                  SAVE RETURN ADDESS
*
VERRPFS  DS    0H
* CHECK BHDR#REC/RPTREND/FREESPACE
*
* INPUT: R4 POINTS TO TYPE/DIRECTION CODE
*
* DESTROYS: R0 R1 R2 R5 R8 R9
         ST    R14,VERSAV14       SAVE R14
         RLLG  R14,R6,32          R14=VSAMDATA (DATA/INDEX BLOCK)
         LLC   R2,DATABHDR.BHDR#REC R2=NO. OF RECORDS
         MHI   R2,RPTRLENG        *RPTR'S
         LA    R2,BHDRLENG(R14,R2) R2=ADDRESS OF RPTREND
         CLI   0(R2),RPTR_END     RPTREND ?
         JNE   VERRPTBD           EXIT IF NOT
         CHSI  1(R2),-1           RPTRREC@=FOXES ?
         JE    VERFSPAC           EXIT IF IT IS
VERRPTBD DS    0H
* RPTREND NOT WHERE EXPECTED
         MVC   VERWORK1+10(5),0(R2) SAVE BAD RPTREND
         SR    R2,R14             R2=OFFSET OF RPTREND
         ST    R2,VERWORK1        SAVE IT
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,4               R9=LENGTH
         LA    R2,VERWORK1        R2=OFFSET
         LA    R8,VERRPEXO        BASE-FREE
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,5               R9=LENGTH
         LA    R2,VERWORK1+10     R2=BAD RPTREND
         LA    R8,VERRPEXD        BASE-FREE
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         LA    R5,CONDATA         R5=CONDATA
         CLI   0(R4),C'D'         IS IT DATA ?
         JE    VERRPTT1           EXIT IF IT IS
         LA    R5,CONINDEX        R5=CONINDEX
         CLI   0(R4),C'I'         IS IT INDEX ?
         JE    VERRPTT1           EXIT IF IT IS
         LA    R5,CONSEGM         R5=CONSEGM
VERRPTT1 DS    0H
         MVC   VERTYPR1,0(R5)     MOVE TYPE
         LA    R5,CONFWD          R5=CONFWD
         CLI   1(R4),C'F'         IS IT FORWARD ?
         JE    VERRPTD2           EXIT IF IT IS
         LA    R5,CONBWD          R5=CONBWD
VERRPTD2 DS    0H
         MVC   VERDIRR1,0(R5)     MOVE DIRECTION
         LA    R9,8               R9=LENGTH
         LA    R2,DATABHDR.BHDRSELF BASE-FREE
         LA    R8,VERXLRR1        R8=DESTINATION ADDRESS
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERRP)    DISPLAY RPTREND NOT WHERE EXPECTED
         WTO   MF=(E,WTOVERR1)    DISPLAY TYPE/DIRECTION/XLRA
         WTO   MF=(E,WTOVERRE)    DISPLAY EXPECTED AT
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
VERFSPAC DS    0H
* CHECK FREESPACE (ASSUMES CONSOLIDATED)
         LA    R2,BHDRLENG(R14)   R2=ADDRESS OF RPTR'S
         USING ZVSAMRPT,R2
* SEGMENT BLOCK AND THERE ARE RECORDS
* SEARCH RPTR'S FOR LOWEST OFFSET
         L     R5,PFXBLKSZ        R5=(ADJUSTED) DATA BLKSIZE
         AHI   R5,-BFTRLENG       R5=MAX DATA OFFSET IF NO RPTR'S
         SR    R0,R0              CLEAR R0
VERDFLOP DS    0H
         CLI   RPTRFLGS,RPTR_END  GOT TO END ?
         JE    VERDFCLC           EXIT IF WE HAVE
         L     R0,RPTRREC@        R0=OFFSET TO RECORD
         CR    R0,R5              LOWER ?
         JNL   VERDFINC           EXIT IF NOT
         LR    R5,R0              R5=LOWER OFFSET
VERDFINC DS    0H
         AHI   R2,RPTRLENG        BUMP RPTR POINTER
         J     VERDFLOP           LOOP
*
VERDFCLC DS    0H
* MATCH FREESPACE OFFSET AND FREESPACE
         L     R8,DATABHDR.BHDRFRE@ R8=FREESPACE OFFSET
         AR    R5,R14             R5=LOWEST DATA ADDRESS
* CATER FOR FIRST SEGMENT ELIX POINTER
         CLI   0(R4),C'D'         IS IT DATA ?
         JNE   VERRPTND           EXIT IF NOT
* DATA CHAIN
         AHI   R2,-RPTRLENG       BACK OFF TO 1ST RPTR
         TM    PFXFFLGS,PFX_AIX   IS IT AN AIX ?
         JNO   VERRPTNS           EXIT IF NOT
* AIX
         TM    RPTRFLGS,RPTR_SEG  FIRST SEGMENT ?
         JNO   VERRPTNS           EXIT IF NOT
* AIX, DATA CHAIN AND FIRST SEGMENT
         AHI   R2,RPTRLENG+8      ADJUST ADDRESS FOR ELIX POINTER
         J     VERRPTND           EXIT
         DROP  R2
*
VERRPTNS DS    0H
* NOT AIX
* --OR--
* DATA CHAIN AND NOT FIRST SEGMENT
         AHI   R2,RPTRLENG        R2=ADDRESS OF RPTREND
VERRPTND DS    0H
         AHI   R2,RPTRLENG        R2=ADDRESS AFTER RPTREND+ELIX PTR
         LR    R9,R2              R9=OFFSET AFTER
         SR    R9,R14                             RPTREND
         SR    R5,R2              R5=FREESPACE
         L     R0,DATABHDR.BHDRFREE R0=FREESPACE
         CR    R8,R9              BHDRFRE@=CALCULATED OFFSET ?
         JNE   VERDFBAD           EXIT IF NOT
         CR    R0,R5              BHDRFREE=CALCULATED FREESPACE ?
         JE    VERRPRET           EXIT IF IT DOES
VERDFBAD DS    0H
* FREESPACE OFFSET OR VALUES MISMATCHED
         LA    R2,VERWORK1        R2=BHDRFRE@
         STM   R8,R9,VERWORK1     SAVE OFFSETS
         LA    R1,TRANHEX         R1=TRANSLATE TABLE ADDRESS
         LA    R9,4               R9=LENGTH
         LA    R8,VEROFFS1        BASE-FREE
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         LA    R9,4               R9=LENGTH
         LA    R2,VERWORK1+4      R2=CALC OFFSET
         LA    R8,VEROFFS2        BASE-FREE
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         ST    R0,VERWORK1        SAVE BHDRFREE
         LA    R9,4               R9=LENGTH
         LA    R2,VERWORK1        R2=BHDRFREE
         LA    R8,VERFSPS1        BASE-FREE
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         ST    R5,VERWORK1        SAVE CALC FREESPACE
         LA    R9,4               R9=LENGTH
         LA    R2,VERWORK1        R2=CALC FREESPACE
         LA    R8,VERFSPS2        BASE-FREE
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         LA    R5,CONDATA         R5=CONDATA
         CLI   0(R4),C'D'         IS IT DATA ?
         JE    VERRPTT2           EXIT IF IT IS
         LA    R5,CONSEGM         R5=CONSEGM
VERRPTT2 DS    0H
         MVC   VERTYPR1,0(R5)     MOVE TYPE
         LA    R5,CONFWD          R5=CONFWD
         CLI   1(R4),C'F'         IS IT FORWARD ?
         JE    VERRPTD3           EXIT IF IT IS
         LA    R5,CONBWD          R5=CONBWD
VERRPTD3 DS    0H
         MVC   VERDIRR1,0(R5)     MOVE DIRECTION
         LA    R9,8               R9=LENGTH
         LA    R2,DATABHDR.BHDRSELF BASE-FREE
         LA    R8,VERXLRR1        R8=DESTINATION ADDRESS
         TROT  R8,R2,1            TRANSLATE TO PRINTABLE HEX
         WTO   MF=(E,WTOVERFS)    DISPLAY FSPACE OFFSET/VALUE MISMATCH
         WTO   MF=(E,WTOVERR1)    DISPLAY TYPE/DIRECTION/XLRA
         WTO   MF=(E,WTOVERF1)    DISPLAY BHDRFRE@/CALC VALUE
         WTO   MF=(E,WTOVERF2)    DISPLAY BHDRFREE/CALC VALUE
         ASI   VERCOUNT,1         COUNT ERRORS
         CHSI  VERCOUNT,VERERMAX  MAXIMUM REACHED ?
         JE    VERABORT           EXIT IF WE HAVE
VERRPRET DS    0H
         DROP  DATABHDR
         L     R14,VERSAV14       RESTORE R14
         BR    R14                RETURN
VERSAV14 DS    F
*
OPENWTOV DS    0H
* WTO OPEN MESSAGE (VERIFY)
*
* INPUT: R1 POINTS TO PATH,X'00'
*
* DESTROYS: R0 R1 R5
         LA    R5,FILEDSN         BASE-FREE
         XC    FILEDSN,FILEDSN    CLEAR PATH NAME
         SR    R0,R0              X'00' IS STOPPER
         MVST  R5,R1              MOVE PATH NAME
         WTO   MF=(E,WTOOPEND)    SHOW IT
         BR    R14                RETURN
*
VEREOFAD DC    AL4(VEREOF)        DATA EOF ADDRESS
VEIEOFAD DC    AL4(VEIEOF)        INDEX EOF ADDRESS
VERINVAL DC    C'INVALID'
*
VEROFFST DC    AL4(0)             OFFSET
VERTRANS DS    CL32               TRANSLATE AREA
VERFILE  DC    XL128'00'          BUILD INPUT PATH\FILE AREA
VERCOUNT DC    A(0)               COUNT ERRORS
VERERMAX EQU   50                 MAXIMUM ERRORS BEFORE ABORT
VERPXEYE DC    C'zPFX'
VERCTEYE DC    C'zCTR'
*
* COUNTS OF BLOCK TYPES
VERDTACT DC    D'0'               DATA BLOCKS
VERELXCT DC    D'0'               ELIX BLOCKS
VERIDXCT DC    D'0'               INDEX BLOCKS
VERSEGCT DC    D'0'               SEGMENT BLOCKS
VERSPCCT DC    D'0'               SPACEMAP BLOCKS
VERBITCT DC    D'0'               SPACEMAP BIT PATTERN COUNT (NOT 00)
*
VERIDXLV DC    16D'0'             INDEX BLOCK COUNTS BY LEVEL
*
VERLIMIT EQU   100000             CHAIN LOOP LIMIT
* CHAIN TYPE/DIRECTION CODES
VERDF    DC    C'DF'              DATA        FORWARDS
VERDB    DC    C'DB'              DATA        BACKWARDS
VERLF    DC    C'LF'              INDEX LEVEL FORWARDS
VERLB    DC    C'LB'              INDEX LEVEL BACKWARDS
VERGF    DC    C'GF'              SEGMENT     FORWARDS
VERGB    DC    C'GB'              SEGMENT     BACKWARDS
VERSF    DC    C'SF'              SPACEMAP    FORWARDS
VERSB    DC    C'SB'              SPACEMAP    BACKWARDS
VEREDIT  DC    X'402020202020202020202120'
VEREDLVL DC    X'40202120'
VERLEVEL DC    AL4(0)             INDEX LEVEL
VERWORK1 DS    XL16
VERWORK2 DS    XL8
*
* HEX TRANSLATE TABLE
*
         DS    0D
TRANHEX  DC    C'000102030405060708090A0B0C0D0E0F'  00-0F
         DC    C'101112131415161718191A1B1C1D1E1F'  10-1F
         DC    C'202122232425262728292A2B2C2D2E2F'  20-2F
         DC    C'303132333435363738393A3B3C3D3E3F'  30-3F
         DC    C'404142434445464748494A4B4C4D4E4F'  40-4F
         DC    C'505152535455565758595A5B5C5D5E5F'  50-5F
         DC    C'606162636465666768696A6B6C6D6E6F'  60-6F
         DC    C'707172737475767778797A7B7C7D7E7F'  70-7F
         DC    C'808182838485868788898A8B8C8D8E8F'  80-8F
         DC    C'909192939495969798999A9B9C9D9E9F'  90-9F
         DC    C'A0A1A2A3A4A5A6A7A8A9AAABACADAEAF'  A0-AF
         DC    C'B0B1B2B3B4B5B6B7B8B9BABBBCBDBEBF'  B0-BF
         DC    C'C0C1C2C3C4C5C6C7C8C9CACBCCCDCECF'  C0-CF
         DC    C'D0D1D2D3D4D5D6D7D8D9DADBDCDDDEDF'  D0-DF
         DC    C'E0E1E2E3E4E5E6E7E8E9EAEBECEDEEEF'  E0-EF
         DC    C'F0F1F2F3F4F5F6F7F8F9FAFBFCFDFEFF'  F0-FF
*
WTOVERH1 DC    AL2(WTOVH1EN-*,0)
         DC    C'zREPRO VERIFY DATA PREFIX BLOCK'
WTOVH1EN EQU   *
*
WTOVERH2 DC    AL2(WTOVH2EN-*,0)
         ORG   *-4
         DC    X'FF'              MARK IT SHOWN
         ORG
         DC    C'zREPRO VERIFY INDEX PREFIX BLOCK'
WTOVH2EN EQU   *
*
WTOVEROR DC    AL2(WTOVEEEN-*,0)
         DC    C'  '
WTOOFFST DC    C'00000000'
         DC    C'  '
WTOCOREC DC    CL32' '
         DC    C'  '
WTOINCOR DC    CL32' '
WTOVEEEN EQU   *
*
WTOVERLM DC    AL2(WTOVLMEN-*,0)
         DC    C'zREPRO VERIFY ERROR LIMIT REACHED'
WTOVLMEN EQU   *
*
WTOVERSE DC    AL2(WTOVSEEN-*,0)
         DC    C'zREPRO VERIFY WARNING:SPANNED AND NO SEGMENTS CREATED'
WTOVSEEN EQU   *
*
WTOVERHF DC    AL2(WTOVHFEN-*,0)
         DC    C'HDR/FTR/SEQ# ERROR XLRA='
VERHFSXL DS    CL16
         DC    C'  '
VERHFSHD DS    CL8
         DC    C'  '
VERHFSFT DS    CL8
WTOVHFEN EQU   *
*
WTOVERHX DC    AL2(WTOVHXEN-*,0)
         DC    C'PFXHXLRA ERROR XLRA='
VERHXLRA DS    CL16
         DC    C'  COUNT='
VERHXCNT DS    CL16
WTOVHXEN EQU   *
*
WTOVERSF DC    AL2(WTOVSFEN-*,0)
         DC    C'BHDRSELF ERROR XLRA='
VERSELF  DS    CL16
         DC    C'  BLOCK='
VERSFBLK DS    CL16
WTOVSFEN EQU   *
*
WTOVERLP DC    AL2(WTOVLPEN-*,0)
         DC    C'LOOP DETECTED CHAIN='
VERTYPE  DS    CL8
         DC    C'  DIRECTION='
VERDIR   DS    CL8
WTOVLPEN EQU   *
*
WTOVERXL DC    AL2(WTOVXLEN-*,0)
VERXLRA  DC    4CL17' '           4 XLRA'S ON EACH OF 2 LINES
WTOVXLEN EQU   *
*
WTOVERWC DC    AL2(WTOVWCEN-*,0)
         DC    C'BLOCK ON WRONG CHAIN XLRA='
VERXLRAW DS    CL16
         DC    C' TYPE='
VERTYPEW DS    CL8
         DC    C' BHDRFLG1='
VERFLGSW DS    CL2
WTOVWCEN EQU   *
*
WTOVERC1 DC    AL2(WTOVC1EN-*,0)
         DC    C'BLOCK COUNT VIA SEQUENTIAL READ DIFFERS FROM'
         DC    C' BLOCK COUNT VIA ANCHOR'
WTOVC1EN EQU   *
*
WTOVERC2 DC    AL2(WTOVC2EN-*,0)
         DC    C'   TYPE='
VERTYPC2 DS    CL8
         DC    C'  DIRECTION='
VERDIRC2 DS    CL8
WTOVC2EN EQU   *
*
WTOVERC3 DC    AL2(WTOVC3EN-*,0)
         DC    C'   SEQUENTIAL READ= '
VERSEQCT DS    CL12
WTOVC3EN EQU   *
*
WTOVERC4 DC    AL2(WTOVC4EN-*,0)
         DC    C'       ANCHOR READ= '
VERANCCT DS    CL12
WTOVC4EN EQU   *
*
WTOVERRP DC    AL2(WTOVRPEN-*,0)
         DC    C'RPTREND NOT WHERE EXPECTED'
WTOVRPEN EQU   *
*
WTOVERR1 DC    AL2(WTOVR1EN-*,0)
         DC    C'   TYPE='
VERTYPR1 DS    CL8
         DC    C'  DIRECTION='
VERDIRR1 DS    CL8
         DC    C'   XLRA='
VERXLRR1 DS    CL16
WTOVR1EN EQU   *
*
WTOVERRE DC    AL2(WTOVREEN-*,0)
         DC    C'   EXPECTED AT  '
VERRPEXO DS    CL8
         DC    C'  '
VERRPEXD DS    CL10
WTOVREEN EQU   *
*
WTOVERFS DC    AL2(WTOVFSEN-*,0)
         DC    C'FREESPACE OFFSET OR VALUE MISMATCH'
WTOVFSEN EQU   *
*
WTOVERF1 DC    AL2(WTOVF1EN-*,0)
         DC    C'   BHDRFRE@='
VEROFFS1 DS    CL8
         DC    C'   CALCULATED='
VEROFFS2 DS    CL8
WTOVF1EN EQU   *
*
WTOVERF2 DC    AL2(WTOVF2EN-*,0)
         DC    C'   BHDRFREE='
VERFSPS1 DS    CL8
         DC    C'   CALCULATED='
VERFSPS2 DS    CL8
WTOVF2EN EQU   *
*
WTOVERBT DC    AL2(WTOVBTEN-*,0)
         DC    C'SPACEMAP BITS NOT EQUAL TO NUMBER OF BLOCKS'
WTOVBTEN EQU   *
*
WTOVERB1 DC    AL2(WTOVB1EN-*,0)
         DC    C'  DIRECTION='
VERBITDR DS    CL8
         DC    C'   BIT PATTERNS='
VERBITPT DS    CL12
         DC    C' BLOCKS='
VERBITBK DS    CL12
WTOVB1EN EQU   *
*
WTOVEROF DC    AL2(WTOVOFEN-*,0)
         DC    C'SPACEMAP PFXMAPOF MISMATCH'
WTOVOFEN EQU   *
*
WTOVERO1 DC    AL2(WTOVO1EN-*,0)
         DC    C'  DIRECTION='
VERPFXDR DS    CL8
         DC    C'   PFXMAPOF='
VERPFXMF DS    CL8
         DC    C' CALCULATED='
VERPFXCC DS    CL8
WTOVO1EN EQU   *
*
WTOVERBX DC    AL2(WTOVBXEN-*,0)
         DC    C'BHDRXLVL ERROR XLRA='
VERXLVLX DS    CL16
         DC    C' XLVL='
VERXLVL  DS    CL2
WTOVBXEN EQU   *
*
WTOVERFG DC    AL2(WTOVFGEN-*,0)
         DC    C'BHDRFLG1 ERROR XLRA='
VERFLGXL DS    CL16
         DC    C' XLVL='
VERFLAGX DS    CL2
         DC    C' FLGS='
VERFLAGF DS    CL2
WTOVFGEN EQU   *
*
WTOVERP1 DC    AL2(WTOVP1EN-*,0)
         DC    C'PFXROOT MISMATCH'
WTOVP1EN EQU   *
*
WTOVERP2 DC    AL2(WTOVP2EN-*,0)
         DC    C' PFXROOT ='
VERPFXRT DS    CL16
WTOVP2EN EQU   *
*
WTOVERP3 DC    AL2(WTOVP3EN-*,0)
         DC    C' PFXBLVLn='
VERBLVL  DS    CL16
WTOVP3EN EQU   *
*
WTOVERP4 DC    AL2(WTOVP4EN-*,0)
         DC    C' PFXELVLn='
VERELVL  DS    CL16
WTOVP4EN EQU   *
*
WTOVERNX DC    AL2(WTOVNXEN-*,0)
         DC    C'FIRST SEGMENT AT  '
VERFST1  DS    CL16
         DC    C'  DOES NOT POINT TO ELIX BLOCK AT '
VERELIX  DS    CL16
WTOVNXEN EQU   *
*
WTOVERPV DC    AL2(WTOVPVEN-*,0)
         DC    C'FIRST SEGMENT AT  '
VERFST2  DS    CL16
         DC    C'  NOT POINTED TO BY ELIX BHDRPREV '
VERELXPV DS    CL16
WTOVPVEN EQU   *
*
WTOVERX1 DC    AL2(WTOVX1EN-*,0)
         DC    C'ELIX XLRA NOT POINTING TO CORRECT SEGMENT TYPE'
WTOVX1EN EQU   *
*
WTOVERX2 DC    AL2(WTOVX2EN-*,0)
         DC    C'  ELIX AT '
VERELIX@ DS    CL16
         DC    C'  ELIX ELEMENT XLRA='
VERELIXX DS    CL16
         DC    C' SPXSEGCC='
VERELXSX DS    CL2
WTOVX2EN EQU   *
*
CONDATA  DC    CL8'DATA'
CONINDEX DC    CL8'INDEX'
CONLEVEL DC    CL8'LEVEL NN'
CONSEGM  DC    CL8'SEGMENT'
CONSPACE DC    CL8'SPACEMAP'
CONFWD   DC    CL8'FORWARD'
CONBWD   DC    CL8'BACKWARD'
*
WTOINFDS DSECT
WTOVRFX  DS    CL9
WTOXXDS  DS    CL5
WTONSPAN DS    CL12
WTOQVSAM DS    CL15
WTORECFM DS    CL2
         DS    CL6
WTODLREC DS    CL8
*
         VCDTD2 ,                 VSAM CATALOG STRUCTURES
         ZVSAMHDR                 HEADER DSECT
         ZVSAMPFX                 PREFIX DSECT
         ZVSAMFTR                 FOOTER DSECT
         ZVSAMMAP                 SPACEMAP DSECT
         ZVSAMRPT                 RECORD POINTER DSECT
         ZVSAMSPX                 SEGMENT PREFIX
*
         DECBD ,                  DECB DSECT
*
         EQUREGS
         END
