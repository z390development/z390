         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERPREVK DS    0H
         ASI   VEROFFST,8         BUMP OFFSET
* BHDRFRE@
         LA    R5,BHDRLENG+PFXLENG+CTRLENG CALC EXPECTED OFFSET
         LH    R4,PFXDNAM@        R4=DATA FILENAME OFFSET
         AR    R4,R6              R4=DATA FILENAME POINTER
         AH    R5,0(R4)           ADD LENGTH
         LH    R4,PFXDPAT@        R4=DATA PATH OFFSET
         AR    R4,R6              R4=DATA PATH POINTER
         AH    R5,0(R4)           ADD LENGTH
         LH    R4,PFXXNAM@        R4=INDEX FILENAME OFFSET
         AR    R4,R6              R4=INDEX FILENAME POINTER
         AH    R5,0(R4)           ADD LENGTH
         LH    R4,PFXXPAT@        R4=INDEX PATH OFFSET
         AR    R4,R6              R4=INDEX PATH POINTER
         AH    R5,0(R4)           ADD LENGTH
         CHHSI CTRLOKEY@,-1       ANY LOW KEY VALUE ?
         JE    VERNOLKY           EXIT IF NONE
         LH    R2,CTRLOKEY@       R2=LOW KEY OFFSET
         AR    R2,R6              R2=LOW KEY POINTER
         AH    R5,0(R2)           ADD LENGTH
VERNOLKY DS    0H
         LR    R2,R5              SAVE LENGTH
         ST    R5,VERWORK1        SAVE IT
         CLC   BHDRFRE@,VERWORK1  CORRECT VALUE ?
         JE    VERFRE@K           EXIT IF IT IS
* BHDRFRE@ IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,BHDRFRE@        R4=ADDRESS OF INCORRECT VALUE
         LA    R5,VERWORK1        R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERFRE@K DS    0H
         ASI   VEROFFST,4         BUMP OFFSET
* BHDRFREE
         LHI   R5,4096            R5=PREFIX BLOCKSIZE
         AHI   R5,-BFTRLENG       -FTR LENGTH
         SR    R5,R2              -CALCULATED BHDRFRE@
         ST    R5,VERWORK1        SAVE IT
         CLC   BHDRFREE,VERWORK1  CORRECT VALUE ?
         JE    VERFREEK           EXIT IF IT IS
* BHDRFREE IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,BHDRFREE        R4=ADDRESS OF INCORRECT VALUE
         LA    R5,VERWORK1        R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERFREEK DS    0H
         ASI   VEROFFST,4+7       BUMP OFFSET+PADDING
* PFXEYE
         CLC   PFXEYE,VERPXEYE    EYE=zPFX ?
         JE    VERPXEYK           EXIT IF IT IS
* PFXEYE IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,PFXEYE          R4=ADDRESS OF INCORRECT VALUE
         LA    R5,VERPXEYE        R5=ADDRESS OF CORRECT VALUE
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERPXEYK DS    0H
         ASI   VEROFFST,4         BUMP OFFSET
* PFXRCLEN MATCHES CATALOG
         CLC   PFXRCLEN,VXXXLMAX  MATCHES CATALOG ?
         JE    VERRCLOK           EXIT IF IT DOES
* IF MAXIMUM VARIABLE SIZE ASSUME IT'S A AIX AS KSDS
         CHSI  VXXXLMAX,32763     MAX VARIABLE SIZE ?
         JE    VERRCLOK           EXIT IF IT IS
* PFXRCLEN IN ERROR
         LA    R9,4               R9=LENGTH TO DISPLAY
         LA    R4,PFXRCLEN        R4=ADDRESS OF INCORRECT VALUE
         SR    R5,R5              SHOW 'INVALID'
         JAS   R14,VERSHOW        BUILD ERROR LINE AND WTO
VERRCLOK DS    0H
         ASI   VEROFFST,4         BUMP OFFSET
