#!/bin/bash
# tstloadnr: LOAD/UNLOAD/VERIFY NULL F-RRDS (zVSAM V2)

########################################
# setup
########################################

cd "$(dirname "$0")"   # vsam2/bash
cd ../..              # repo root

input=vsam2/data
data=vsam2/data
catdir=vsam2/mlc
code=vsam2/mlc
logfile=tstloadnr.LOG
zvsam="zVSAM(2)"

trace=0
if [ $# -gt 0 ]; then
    SHELLNOCASEMATCH=$(shopt -p nocasematch)
    shopt -s nocasematch
    case "$1" in
        tron)  shift; trace=1 ;;
        troff) shift; trace=0 ;;
    esac
    $SHELLNOCASEMATCH
fi
if [ $trace -eq 1 ]; then set -x; fi

########################################
# code
########################################

rc=0
echo "$0" > "${data}/${logfile}"

# LOAD
echo "--                      " >> "${data}/${logfile}"
echo "-- Step 1: load cluster " >> "${data}/${logfile}"
echo "--                      " >> "${data}/${logfile}"
# LOAD THE F-RRDS with a NULL file
rm -f "${data}/NULLRRDS.DTA" "${data}/NULLRRDS.IDX"

export INQSAM="${input}/NULLFILE.TXT[RECFM=FT]"
export OUTVSAM="${data}/Z390CAT2.NULLRRDS"
export Z390CAT2="${catdir}/"
bash/ez390 "${code}/ZREPRO" "PARM(LOAD)" DUMP "$zvsam"
rc=$?
cat "${code}/ZREPRO.LOG" >> "${data}/${logfile}"
if [ $rc -ne 0 ]; then echo "$0 ERROR: Encountered RC $rc - exiting"; exit $rc; fi


# UNLOAD
echo "--                        " >> "${data}/${logfile}"
echo "-- Step 2: unload cluster " >> "${data}/${logfile}"
echo "--                        " >> "${data}/${logfile}"
# UNLOAD THE F-RRDS (ORIGINAL INPUT NULLFILE.TXT)
export INVSAM="${data}/Z390CAT2.NULLRRDS"
export OUTQSAM="${data}/NULLRRDS.TXO[RECFM=FT]"
export Z390CAT2="${catdir}"
bash/ez390 "${code}/ZREPRO" "PARM(UNLOAD)" DUMP "$zvsam"
rc=$?
cat "${code}/ZREPRO.LOG" >> "${data}/${logfile}"
if [ $rc -ne 0 ]; then echo "$0 ERROR: Encountered RC $rc - exiting"; exit $rc; fi


# COMPARE
echo "--                             " >> "${data}/${logfile}"
echo "-- Step 3: compare unload data " >> "${data}/${logfile}"
echo "--                             " >> "${data}/${logfile}"
if diff -q --strip-trailing-cr "${input}/NULLFILE.TXT" "${data}/NULLRRDS.TXO"; then
    echo "diff: no differences encountered" >> "${data}/${logfile}"
else
    rc=$?
    echo "diff: files differ" >> "${data}/${logfile}"
    diff --strip-trailing-cr "${input}/NULLFILE.TXT" "${data}/NULLRRDS.TXO" >> "${data}/${logfile}" 2>&1 || true
    echo "$0 ERROR: Encountered RC $rc - exiting"
    exit $rc
fi


# VERIFY
echo "--                            " >> "${data}/${logfile}"
echo "-- Step 4: verify the cluster " >> "${data}/${logfile}"
echo "--                            " >> "${data}/${logfile}"
# VERIFY THE F-RRDS
export INVSAM="${data}/Z390CAT2.NULLRRDS"
export Z390CAT2="${catdir}/"
bash/ez390 "${code}/ZREPRO" "PARM(VERIFY)" DUMP "$zvsam"
rc=$?
cat "${code}/ZREPRO.LOG" >> "${data}/${logfile}"
if [ $rc -ne 0 ]; then echo "$0 ERROR: Encountered RC $rc - exiting"; exit $rc; fi

echo "--               " >> "${data}/${logfile}"
echo "-- Test complete " >> "${data}/${logfile}"
echo "--               " >> "${data}/${logfile}"

exit $rc
