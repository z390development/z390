#!/bin/bash

# bldvsam: assemble and link zVSAM V2 utilities

set -e              # exit on all errors
cd $(dirname $0)    # set to directory of script
cd ../..            # go to root

bash/asml vsam2/mlc/ZREPRO   "zVSAM(1)" stats "sys390(linklib)"
bash/asml vsam2/mlc/ZVSAM19C "zVSAM(2)" stats "sys390(linklib)"
bash/asml vsam2/mlc/Z390CAT2 "zVSAM(2)" stats