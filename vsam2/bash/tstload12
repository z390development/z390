#!/bin/bash
# tstload12: LOAD/UNLOAD/VERIFY VS-KSDS + AIX (zVSAM V2)

########################################
# setup
########################################

cd "$(dirname "$0")"   # vsam2/bash
cd ../..              # repo root

input=vsam2/data
data=vsam2/data
catdir=vsam2/mlc
code=vsam2/mlc
logfile=tstload12.LOG
zvsam="zVSAM(2)"

trace=0
if [ $# -gt 0 ]; then
    SHELLNOCASEMATCH=$(shopt -p nocasematch)
    shopt -s nocasematch
    case "$1" in
        tron)  shift; trace=1 ;;
        troff) shift; trace=0 ;;
    esac
    $SHELLNOCASEMATCH
fi
if [ $trace -eq 1 ]; then set -x; fi

########################################
# code
########################################

rc=0
echo "$0" > "${data}/${logfile}"

# LOAD
echo "--                      " >> "${data}/${logfile}"
echo "-- Step 1: load cluster " >> "${data}/${logfile}"
echo "--                      " >> "${data}/${logfile}"
# LOAD THE VS-KSDS
rm -f "${data}/MYFILE12.DTA" "${data}/MYFILE12.IDX"

export INQSAM="${input}/MYFILEAV.TXT[RECFM=VT]"
export OUTVSAM="${data}/Z390CAT2.MYFILE12"
export Z390CAT2="${catdir}/"
bash/ez390 "${code}/ZREPRO" "PARM(LOAD)" DUMP "TIME(120)" "$zvsam"
rc=$?
cat "${code}/ZREPRO.LOG" >> "${data}/${logfile}"
if [ $rc -ne 0 ]; then echo "$0 ERROR: Encountered RC $rc - exiting"; exit $rc; fi


# UNLOAD
echo "--                        " >> "${data}/${logfile}"
echo "-- Step 2: unload cluster " >> "${data}/${logfile}"
echo "--                        " >> "${data}/${logfile}"
# UNLOAD THE VS-KSDS (ORIGINAL INPUT MYFILEAV.TXT)
export INVSAM="${data}/Z390CAT2.MYFILE12"
export OUTQSAM="${data}/MYFILE12.TXO[RECFM=VT]"
export Z390CAT2="${catdir}"
bash/ez390 "${code}/ZREPRO" "PARM(UNLOAD)" DUMP "$zvsam"
rc=$?
cat "${code}/ZREPRO.LOG" >> "${data}/${logfile}"
if [ $rc -ne 0 ]; then echo "$0 ERROR: Encountered RC $rc - exiting"; exit $rc; fi


# COMPARE
echo "--                             " >> "${data}/${logfile}"
echo "-- Step 3: compare unload data " >> "${data}/${logfile}"
echo "--                             " >> "${data}/${logfile}"
if diff -q --strip-trailing-cr "${input}/MYFILEAV.TXT" "${data}/MYFILE12.TXO"; then
    echo "diff: no differences encountered" >> "${data}/${logfile}"
else
    rc=$?
    echo "diff: files differ" >> "${data}/${logfile}"
    diff --strip-trailing-cr "${input}/MYFILEAV.TXT" "${data}/MYFILE12.TXO" >> "${data}/${logfile}" 2>&1 || true
    echo "$0 ERROR: Encountered RC $rc - exiting"
    exit $rc
fi


# VERIFY
echo "--                            " >> "${data}/${logfile}"
echo "-- Step 4: verify the cluster " >> "${data}/${logfile}"
echo "--                            " >> "${data}/${logfile}"
# VERIFY THE VS-KSDS
export INVSAM="${data}/Z390CAT2.MYFILE12"
export Z390CAT2="${catdir}/"
bash/ez390 "${code}/ZREPRO" "PARM(VERIFY)" DUMP "$zvsam"
rc=$?
cat "${code}/ZREPRO.LOG" >> "${data}/${logfile}"
if [ $rc -ne 0 ]; then echo "$0 ERROR: Encountered RC $rc - exiting"; exit $rc; fi


# BUILDAIX step 5
echo "--                               " >> "${data}/${logfile}"
echo "-- Step 5: build alternate index " >> "${data}/${logfile}"
echo "--                               " >> "${data}/${logfile}"
# BUILDAIX UNIQUE MYAIXC1 OVER MYFILE12 VS-KSDS
rm -f "${data}/MYAIXC1.DTA" "${data}/MYAIXC1.IDX"

export INVSAM="${data}/Z390CAT2.MYFILE12"
export OUTVSAM="${data}/Z390CAT2.MYAIXC1"
export Z390CAT2="${catdir}/"
bash/ez390 "${code}/ZREPRO" "PARM(BUILDAIX)" NOTIME DUMP "MEM(16)" "$zvsam"
rc=$?
cat "${code}/ZREPRO.LOG" >> "${data}/${logfile}"
if [ $rc -ne 0 ]; then echo "$0 ERROR: Encountered RC $rc - exiting"; exit $rc; fi

echo "--               " >> "${data}/${logfile}"
echo "-- Test complete " >> "${data}/${logfile}"
echo "--               " >> "${data}/${logfile}"

exit $rc
