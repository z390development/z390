         RT1   CCE
         CLC   =FL4'84',DFHRESP(DISABLED)  RPI 687      
         RT1   CCE
         RT1   CCE,=FL4'0',DFHRESP(NORMAL) 
         RT1   CCE,=FL4'1',DFHRESP(ERROR)
         RT1   CCE,=FL4'11',DFHRESP(TERMIDERR)    RPI 928      
         RT1   CCE,=FL4'12',DFHRESP(FILENOTFOUND) RPI 687
         RT1   CCE,=FL4'12',DFHRESP(DSIDERR)      RPI 905
         RT1   CCE,=FL4'13',DFHRESP(NOTFND)       RPI 687 RPI 690
         RT1   CCE,=FL4'14',DFHRESP(DUPREC)       RPI 687
         RT1   CCE,=FL4'15',DFHRESP(DUPKEY)       RPI 687
         RT1   CCE,=FL4'16',DFHRESP(INVREQ)
         RT1   CCE,=FL4'17',DFHRESP(IOERR)        RPI 928      
         RT1   CCE,=FL4'18',DFHRESP(NOSPACE)      RPI 687
         RT1   CCE,=FL4'19',DFHRESP(NOTOPEN)      RPI 687
         RT1   CCE,=FL4'20',DFHRESP(ENDFILE)      RPI 687
         RT1   CCE,=FL4'21',DFHRESP(ILLOGIC)      RPI 729
         RT1   CCE,=FL4'22',DFHRESP(LENGERR)
         RT1   CCE,=FL4'26',DFHRESP(ITEMERR)      RPI 662
         RT1   CCE,=FL4'27',DFHRESP(PGMIDERR)
         RT1   CCE,=FL4'28',DFHRESP(TRANSIDERR)   RPI 928      
         RT1   CCE,=FL4'29',DFHRESP(ENDDATA)      RPI 928      
         RT1   CCE,=FL4'31',DFHRESP(EXPIRED)      RPI 751
         RT1   CCE,=FL4'36',DFHRESP(MAPFAIL)      RPI 841
         RT1   CCE,=FL4'38',DFHRESP(INVMPSZ)      RPI 841
         RT1   CCE,=FL4'40',DFHRESP(OVERFLOW)     RPI 841
         RT1   CCE,=FL4'44',DFHRESP(QIDERR)       RPI 662
         RT1   CCE,=FL4'55',DFHRESP(ENQBUSY)      RPI 951      
         RT1   CCE,=FL4'56',DFHRESP(ENVDEFERR)    RPI 928      
