         RT1   CCE
         CLC   =FL4'29',DFHRESP(ENDDATA)      RPI 928      
         RT1   CCE
         CLC   =FL4'31',DFHRESP(EXPIRED)   RPI 751
         RT1   CCE
         CLC   =FL4'36',DFHRESP(MAPFAIL)   RPI 841
         RT1   CCE
         CLC   =FL4'38',DFHRESP(INVMPSZ)   RPI 841
         RT1   CCE
         CLC   =FL4'40',DFHRESP(OVERFLOW)  RPI 841
         RT1   CCE
         CLC   =FL4'44',DFHRESP(QIDERR)    RPI 662
         RT1   CCE
         CLC   =FL4'55',DFHRESP(ENQBUSY)   RPI 951      
         RT1   CCE
         CLC   =FL4'56',DFHRESP(ENVDEFERR) RPI 928      
         RT1   CCE
